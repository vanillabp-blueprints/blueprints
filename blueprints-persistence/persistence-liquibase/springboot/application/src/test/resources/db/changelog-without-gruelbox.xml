<?xml version="1.0" encoding="UTF-8"?>
<!--
  The changelog of a deployment which forgot the one table which is not VanillaBP's: VanillaBP's
  two tables are there, the workflow module's are there, TXNO_OUTBOX is not.

  This is the mistake this blueprint invites. gruelbox's schema is the one thing an application
  has to write down itself, so it is the one thing a changelog can forget without the compiler,
  the artifact or a review noticing. MissingTableIT shows what the boot says about it.

  It lives in the test sources because an application has no use for it.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <include file="vanillabp/schema/changelog.xml" />

  <include file="loan-approval/db/changelog.xml" relativeToChangelogFile="false" />

</databaseChangeLog>
