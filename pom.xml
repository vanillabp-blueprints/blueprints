<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.vanillabp.blueprints</groupId>
  <artifactId>blueprints</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>VanillaBP blueprints</name>
  <description>Development monorepo of the VanillaBP blueprints. Each blueprint is delivered as a repository of its own, split out of this repository by CI.</description>
  <url>https://github.com/vanillabp-blueprints/blueprints</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <!--
    One module per blueprint and platform, using the path '<blueprint-id>/<platform>/'
    (e.g. 'module-single/springboot'). This POM aggregates those modules but is
    deliberately NOT their Maven parent: every blueprint has to build on its own after
    having been split into its own repository. See CONTRIBUTING.md.
  -->
  <modules>
    <module>module-single/springboot</module>
  </modules>

  <scm>
    <connection>scm:git:https://github.com/vanillabp-blueprints/blueprints.git</connection>
    <developerConnection>scm:git:https://github.com/vanillabp-blueprints/blueprints.git</developerConnection>
    <url>http://github.com/vanillabp-blueprints/blueprints/tree/main</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <build>
    <plugins>
      <!--
        Formatting is checked once for the entire repository, not per blueprint: a
        blueprint's POM shows what a VanillaBP application needs and nothing else.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <pom>
            <includes>
              <include>**/pom.xml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
            </excludes>
            <sortPom>
              <quiet>true</quiet>
            </sortPom>
          </pom>
          <markdown>
            <includes>
              <include>**/*.md</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
            </excludes>
            <flexmark/>
          </markdown>
          <yaml>
            <includes>
              <include>**/*.yaml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!--
                Workflow files are excluded on purpose: the formatter drops comments and
                unquotes version numbers, which silently turns '3.10' into '3.1'.
              -->
              <exclude>.github/workflows/**</exclude>
              <!--
                The YAML of a blueprint is excluded for the same reason: the formatter
                drops comments, and in a blueprint the comments are what is being taught.
              -->
              <exclude>**/src/**</exclude>
            </excludes>
            <jackson>
              <yamlFeatures>
                <MINIMIZE_QUOTES>true</MINIMIZE_QUOTES>
                <WRITE_DOC_START_MARKER>false</WRITE_DOC_START_MARKER>
                <INDENT_ARRAYS_WITH_INDICATOR>true</INDENT_ARRAYS_WITH_INDICATOR>
              </yamlFeatures>
            </jackson>
          </yaml>
          <java>
            <!--
              Spotless runs in this POM only, and its default Java includes cover the
              sources of THIS project - which has none. The blueprints and the test
              harness reference have to be named explicitly, otherwise their Java is
              never formatted and the harness copies drift from their reference.
            -->
            <includes>
              <include>**/src/main/java/**/*.java</include>
              <include>**/src/test/java/**/*.java</include>
              <include>templates/**/*.java</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
            </excludes>
            <eclipse>
              <!-- https://help.eclipse.org/latest/index.jsp?topic=%2Forg.eclipse.jdt.doc.isv%2Freference%2Fapi%2Forg%2Feclipse%2Fjdt%2Fcore%2Fformatter%2FDefaultCodeFormatterConstants.html -->
              <file>${maven.multiModuleProjectDirectory}/formatting_conventions.xml</file>
              <version>4.35</version>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,org,com,at.phactum</order>
            </importOrder>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>process-sources</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    The BPMS a blueprint runs on is a Maven profile, never a code change - that is one
    of the statements every blueprint makes. The profiles are declared here so that
    '-P<bpms>' can be passed to the entire reactor; each blueprint declares profiles of
    the same IDs adding the VanillaBP adapter dependency of that BPMS.
  -->
  <profiles>
    <profile>
      <!-- The default: an embedded engine, so 'mvn verify' needs no infrastructure. -->
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <blueprint.bpms>camunda7</blueprint.bpms>
      </properties>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <blueprint.bpms>camunda8</blueprint.bpms>
      </properties>
    </profile>
    <profile>
      <id>process-engine-api</id>
      <properties>
        <blueprint.bpms>process-engine-api</blueprint.bpms>
      </properties>
    </profile>
  </profiles>
</project>
