<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.bpmn-multi-instance-subprocess-springboot</groupId>
    <artifactId>bpmn-multi-instance-subprocess</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>loan-approval</artifactId>
  <name>Workflow module 'loan-approval'</name>
  <description>The workflow module: BPMN models and the code implementing them, packaged as a JAR.</description>

  <dependencies>
    <!--
      The workflow module knows the VanillaBP APIs, but no BPMS: 'vanillabp-spring-boot-support'
      deliberately does not expose any BPMS API, so the hexagonal architecture cannot be
      broken by accident. The adapter is chosen by the application (see ../application).
    -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-spring-boot-support</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      Testing the workflow module means running it: the test sources bring their own tiny
      Spring Boot application (TestApplication), a database and a BPMS adapter. This is the
      normal case - a workflow module is a JAR and cannot be started on its own.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bpms>camunda7</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda7-adapter-spring-boot</artifactId>
          <version>${camunda7-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <!--
          The JSON dataformat for the list the model loops over, see 'serialization-format' in
          application-camunda7.yaml. Its version is the engine version of the adapter.
        -->
        <dependency>
          <groupId>org.camunda.bpm</groupId>
          <artifactId>camunda-engine-plugin-spin</artifactId>
          <version>${camunda7-engine.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.camunda.spin</groupId>
          <artifactId>camunda-spin-dataformat-json-jackson</artifactId>
          <version>${camunda7-engine.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <bpms>camunda8</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda8-adapter-spring-boot</artifactId>
          <version>${camunda8-adapter.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>operaton</id>
      <properties>
        <bpms>operaton</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>operaton-adapter-spring-boot</artifactId>
          <version>${operaton-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <!--
          The JSON dataformat for the list the model loops over, see 'serialization-format' in
          application-operaton.yaml. Its version is the engine version of the adapter.
        -->
        <dependency>
          <groupId>org.operaton.bpm</groupId>
          <artifactId>operaton-engine-plugin-spin</artifactId>
          <version>${operaton-engine.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.operaton.spin</groupId>
          <artifactId>operaton-spin-dataformat-json-jackson</artifactId>
          <version>${operaton-engine.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>cibseven</id>
      <properties>
        <bpms>cibseven</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>cibseven-adapter-spring-boot</artifactId>
          <version>${cibseven-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <!--
          The JSON dataformat for the list the model loops over, see 'serialization-format' in
          application-cibseven.yaml. Its version is the engine version of the adapter.
        -->
        <dependency>
          <groupId>org.cibseven.bpm</groupId>
          <artifactId>cibseven-engine-plugin-spin</artifactId>
          <version>${cibseven-engine.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.cibseven.spin</groupId>
          <artifactId>cibseven-spin-dataformat-json-jackson</artifactId>
          <version>${cibseven-engine.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
