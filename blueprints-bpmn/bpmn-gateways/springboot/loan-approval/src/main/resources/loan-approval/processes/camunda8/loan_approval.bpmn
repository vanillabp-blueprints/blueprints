<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_loan_approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="loan_approval" name="Loan approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent_LoanRequested" name="Loan requested">
      <bpmn:outgoing>Flow_ToRetrieveCreditRating</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRetrieveCreditRating" sourceRef="StartEvent_LoanRequested" targetRef="ServiceTask_RetrieveCreditRating" />
    <bpmn:serviceTask id="ServiceTask_RetrieveCreditRating" name="Retrieve credit rating">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="retrieveCreditRating" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRetrieveCreditRating</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToDecision" sourceRef="ServiceTask_RetrieveCreditRating" targetRef="Gateway_Decision" />
    <!--
      The gateway routes, it does not decide. Both conditions read ONE attribute of the
      workflow aggregate which the business code wrote before and this adapter shares with
      the cluster; the threshold behind that attribute is configuration rather than model.
      One attribute rather than two booleans is deliberate: conditions that can be true at
      the same time leave it to the engine which branch is taken, and engines differ
      there.
    -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="How does the rating look?" default="Flow_ToRejectLoan">
      <bpmn:incoming>Flow_ToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApproveLoan</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToRequestManualReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToRejectLoan</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToApproveLoan" name="good enough" sourceRef="Gateway_Decision" targetRef="ServiceTask_ApproveLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ratingBand = "acceptable"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToRequestManualReview" name="worth a look" sourceRef="Gateway_Decision" targetRef="ServiceTask_RequestManualReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ratingBand = "review"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!-- The default flow: taken when no condition holds, so the process cannot get stuck. -->
    <bpmn:sequenceFlow id="Flow_ToRejectLoan" name="too risky" sourceRef="Gateway_Decision" targetRef="ServiceTask_RejectLoan" />
    <bpmn:serviceTask id="ServiceTask_ApproveLoan" name="Approve loan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="approveLoan" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToApproveLoan</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoanApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_RequestManualReview" name="Request manual review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="requestManualReview" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRequestManualReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToManualReview</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_RejectLoan" name="Reject loan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rejectLoan" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRejectLoan</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoanRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLoanApproved" sourceRef="ServiceTask_ApproveLoan" targetRef="EndEvent_LoanApproved" />
    <bpmn:sequenceFlow id="Flow_ToManualReview" sourceRef="ServiceTask_RequestManualReview" targetRef="EndEvent_ManualReview" />
    <bpmn:sequenceFlow id="Flow_ToLoanRejected" sourceRef="ServiceTask_RejectLoan" targetRef="EndEvent_LoanRejected" />
    <bpmn:endEvent id="EndEvent_LoanApproved" name="Loan approved">
      <bpmn:incoming>Flow_ToLoanApproved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_ManualReview" name="Manual review">
      <bpmn:incoming>Flow_ToManualReview</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_LoanRejected" name="Loan rejected">
      <bpmn:incoming>Flow_ToLoanRejected</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loan_approval">
      <bpmndi:BPMNShape id="StartEvent_LoanRequested_di" bpmnElement="StartEvent_LoanRequested">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="134" y="225" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_RetrieveCreditRating_di" bpmnElement="ServiceTask_RetrieveCreditRating">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="395" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="285" y="232" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_ApproveLoan_di" bpmnElement="ServiceTask_ApproveLoan">
        <dc:Bounds x="530" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_RequestManualReview_di" bpmnElement="ServiceTask_RequestManualReview">
        <dc:Bounds x="530" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_RejectLoan_di" bpmnElement="ServiceTask_RejectLoan">
        <dc:Bounds x="530" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanApproved_di" bpmnElement="EndEvent_LoanApproved">
        <dc:Bounds x="692" y="42" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="676" y="85" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ManualReview_di" bpmnElement="EndEvent_ManualReview">
        <dc:Bounds x="692" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="676" y="225" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanRejected_di" bpmnElement="EndEvent_LoanRejected">
        <dc:Bounds x="692" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="677" y="365" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToRetrieveCreditRating_di" bpmnElement="Flow_ToRetrieveCreditRating">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDecision_di" bpmnElement="Flow_ToDecision">
        <di:waypoint x="340" y="200" />
        <di:waypoint x="395" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToApproveLoan_di" bpmnElement="Flow_ToApproveLoan">
        <di:waypoint x="420" y="175" />
        <di:waypoint x="420" y="60" />
        <di:waypoint x="530" y="60" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="105" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRequestManualReview_di" bpmnElement="Flow_ToRequestManualReview">
        <di:waypoint x="445" y="200" />
        <di:waypoint x="530" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="455" y="182" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRejectLoan_di" bpmnElement="Flow_ToRejectLoan">
        <di:waypoint x="420" y="225" />
        <di:waypoint x="420" y="340" />
        <di:waypoint x="530" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="295" width="49" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLoanApproved_di" bpmnElement="Flow_ToLoanApproved">
        <di:waypoint x="630" y="60" />
        <di:waypoint x="692" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToManualReview_di" bpmnElement="Flow_ToManualReview">
        <di:waypoint x="630" y="200" />
        <di:waypoint x="692" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLoanRejected_di" bpmnElement="Flow_ToLoanRejected">
        <di:waypoint x="630" y="340" />
        <di:waypoint x="692" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
