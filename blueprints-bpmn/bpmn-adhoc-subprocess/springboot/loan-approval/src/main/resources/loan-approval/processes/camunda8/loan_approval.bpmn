<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_loan_approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="loan_approval" name="Loan approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent_LoanRequested" name="Loan requested">
      <bpmn:outgoing>Flow_ToRetrieveCreditRating</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRetrieveCreditRating" sourceRef="StartEvent_LoanRequested" targetRef="ServiceTask_RetrieveCreditRating" />
    <bpmn:serviceTask id="ServiceTask_RetrieveCreditRating" name="Retrieve credit rating">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="retrieveCreditRating" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRetrieveCreditRating</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWhoPicks</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToWhoPicks" sourceRef="ServiceTask_RetrieveCreditRating" targetRef="Gateway_WhoPicks" />
    <!--
      Who picks the additional checks. A big loan is looked at by a case worker, everything
      else is decided by a decision table. Both branches produce the same thing, a list of
      element ids, and the ad-hoc subprocess behind them does not know which of them ran.
    -->
    <bpmn:exclusiveGateway id="Gateway_WhoPicks" name="Big loan?" default="Flow_ToChooseChecks">
      <bpmn:incoming>Flow_ToWhoPicks</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSelectChecks</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToChooseChecks</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToSelectChecks" name="yes" sourceRef="Gateway_WhoPicks" targetRef="UserTask_SelectChecks">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=amount &gt; 10000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!--
      The case worker picks. The handler stores the task id, and the API writes the picked
      element ids onto the workflow aggregate before completing the task.
    -->
    <bpmn:userTask id="UserTask_SelectChecks" name="Select additional checks">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="selectChecks" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSelectChecks</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectedToPicked</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ToChooseChecks" name="no" sourceRef="Gateway_WhoPicks" targetRef="BusinessRuleTask_ChooseChecks" />
    <!--
      The decision table picks, and no Java is involved at all: the cluster evaluates the
      DMN deployed next to this file and writes its result into the process variable the
      ad-hoc subprocess reads. The hit policy is COLLECT, so the result is a list.
    -->
    <bpmn:businessRuleTask id="BusinessRuleTask_ChooseChecks" name="Choose additional checks">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="checks_to_run" resultVariable="checksToRun" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToChooseChecks</bpmn:incoming>
      <bpmn:outgoing>Flow_ChosenToPicked</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_SelectedToPicked" sourceRef="UserTask_SelectChecks" targetRef="Gateway_ChecksPicked" />
    <bpmn:sequenceFlow id="Flow_ChosenToPicked" sourceRef="BusinessRuleTask_ChooseChecks" targetRef="Gateway_ChecksPicked" />
    <bpmn:exclusiveGateway id="Gateway_ChecksPicked">
      <bpmn:incoming>Flow_SelectedToPicked</bpmn:incoming>
      <bpmn:incoming>Flow_ChosenToPicked</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAdditionalChecks</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToAdditionalChecks" sourceRef="Gateway_ChecksPicked" targetRef="AdHocSubProcess_AdditionalChecks" />
    <!--
      The element this blueprint is about. Its activities have no sequence flows between
      them, and which of them run is decided while the workflow already stands here:
      'activeElementsCollection' is a FEEL expression naming the ids of the elements to
      activate, read once when the workflow enters the subprocess.

      No completion condition is modelled, so the workflow leaves the element when
      everything it activated is done.
    -->
    <bpmn:adHocSubProcess id="AdHocSubProcess_AdditionalChecks" name="Additional checks">
      <bpmn:extensionElements>
        <zeebe:adHoc activeElementsCollection="=checksToRun" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAdditionalChecks</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInformCustomer</bpmn:outgoing>
      <!--
        Ordinary service tasks. Each of them needs a @WorkflowTask method like every other
        task of this process, and their element ids are what the list above names.
      -->
      <bpmn:serviceTask id="Check_Income" name="Check income">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="checkIncome" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Check_Fraud" name="Check for fraud">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="checkFraud" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Check_Collateral" name="Check collateral">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="checkCollateral" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_ToInformCustomer" sourceRef="AdHocSubProcess_AdditionalChecks" targetRef="ServiceTask_InformCustomer" />
    <bpmn:serviceTask id="ServiceTask_InformCustomer" name="Inform customer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="informCustomer" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToInformCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoanAssessed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLoanAssessed" sourceRef="ServiceTask_InformCustomer" targetRef="EndEvent_LoanAssessed" />
    <bpmn:endEvent id="EndEvent_LoanAssessed" name="Loan assessed">
      <bpmn:incoming>Flow_ToLoanAssessed</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loan_approval">
      <bpmndi:BPMNShape id="StartEvent_LoanRequested_di" bpmnElement="StartEvent_LoanRequested">
        <dc:Bounds x="152" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="134" y="245" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_RetrieveCreditRating_di" bpmnElement="ServiceTask_RetrieveCreditRating">
        <dc:Bounds x="240" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_WhoPicks_di" bpmnElement="Gateway_WhoPicks" isMarkerVisible="true">
        <dc:Bounds x="395" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="391" y="258" width="58" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_SelectChecks_di" bpmnElement="UserTask_SelectChecks">
        <dc:Bounds x="500" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BusinessRuleTask_ChooseChecks_di" bpmnElement="BusinessRuleTask_ChooseChecks">
        <dc:Bounds x="500" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ChecksPicked_di" bpmnElement="Gateway_ChecksPicked" isMarkerVisible="true">
        <dc:Bounds x="675" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AdHocSubProcess_AdditionalChecks_di" bpmnElement="AdHocSubProcess_AdditionalChecks" isExpanded="true">
        <dc:Bounds x="790" y="80" width="220" height="340" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Check_Income_di" bpmnElement="Check_Income">
        <dc:Bounds x="850" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Check_Fraud_di" bpmnElement="Check_Fraud">
        <dc:Bounds x="850" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Check_Collateral_di" bpmnElement="Check_Collateral">
        <dc:Bounds x="850" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_InformCustomer_di" bpmnElement="ServiceTask_InformCustomer">
        <dc:Bounds x="1060" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanAssessed_di" bpmnElement="EndEvent_LoanAssessed">
        <dc:Bounds x="1220" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1207" y="245" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToRetrieveCreditRating_di" bpmnElement="Flow_ToRetrieveCreditRating">
        <di:waypoint x="188" y="220" />
        <di:waypoint x="240" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToWhoPicks_di" bpmnElement="Flow_ToWhoPicks">
        <di:waypoint x="340" y="220" />
        <di:waypoint x="395" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToSelectChecks_di" bpmnElement="Flow_ToSelectChecks">
        <di:waypoint x="420" y="195" />
        <di:waypoint x="420" y="130" />
        <di:waypoint x="500" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="150" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToChooseChecks_di" bpmnElement="Flow_ToChooseChecks">
        <di:waypoint x="420" y="245" />
        <di:waypoint x="420" y="310" />
        <di:waypoint x="500" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430" y="278" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SelectedToPicked_di" bpmnElement="Flow_SelectedToPicked">
        <di:waypoint x="600" y="130" />
        <di:waypoint x="700" y="130" />
        <di:waypoint x="700" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ChosenToPicked_di" bpmnElement="Flow_ChosenToPicked">
        <di:waypoint x="600" y="310" />
        <di:waypoint x="700" y="310" />
        <di:waypoint x="700" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToAdditionalChecks_di" bpmnElement="Flow_ToAdditionalChecks">
        <di:waypoint x="725" y="220" />
        <di:waypoint x="790" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToInformCustomer_di" bpmnElement="Flow_ToInformCustomer">
        <di:waypoint x="1010" y="220" />
        <di:waypoint x="1060" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLoanAssessed_di" bpmnElement="Flow_ToLoanAssessed">
        <di:waypoint x="1160" y="220" />
        <di:waypoint x="1220" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
