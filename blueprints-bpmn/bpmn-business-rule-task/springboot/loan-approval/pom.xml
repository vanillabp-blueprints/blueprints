<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.bpmn-business-rule-task-springboot</groupId>
    <artifactId>bpmn-business-rule-task</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>loan-approval</artifactId>
  <name>Workflow module 'loan-approval'</name>
  <description>The workflow module: BPMN models and the code implementing them, packaged as a JAR.</description>

  <dependencies>
    <!--
      The workflow module knows the VanillaBP APIs, but no BPMS: 'vanillabp-spring-boot-support'
      deliberately does not expose any BPMS API, so the hexagonal architecture cannot be
      broken by accident. The adapter is chosen by the application (see ../application).
    -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-spring-boot-support</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      Testing the workflow module means running it: the test sources bring their own tiny
      Spring Boot application (TestApplication), a database and a BPMS adapter. This is the
      normal case - a workflow module is a JAR and cannot be started on its own.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The API of this module is written as the OpenAPI file
        'src/main/resources/openapi/loan-approval.yaml'. This plugin generates the Java interface
        'LoanApprovalApi' from it, with the paths, the parameters and the answers. 'ApiController'
        implements the interface and holds nothing but the code of each call.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <!-- The settings every API of this module shares. -->
        <configuration>
          <generatorName>spring</generatorName>
          <generateSupportingFiles>false</generateSupportingFiles>
          <configOptions>
            <useSpringBoot4>true</useSpringBoot4>
            <!-- One interface per tag, named after it. -->
            <useTags>true</useTags>
            <!-- Only the interface. The controller implements it. -->
            <interfaceOnly>true</interfaceOnly>
            <skipDefaultInterface>true</skipDefaultInterface>
            <!-- The paths in the file are complete, so the interface needs no path of its own. -->
            <requestMappingMode>none</requestMappingMode>
            <!-- A method returns the answer itself. Spring Boot turns it into the response. -->
            <useResponseEntity>false</useResponseEntity>
            <!-- No library beyond Spring Web and Jackson: no Swagger annotations, no bean validation. -->
            <useRecords>true</useRecords>
            <useJspecify>true</useJspecify>
            <openApiNullable>false</openApiNullable>
            <useBeanValidation>false</useBeanValidation>
            <documentationProvider>none</documentationProvider>
            <annotationLibrary>none</annotationLibrary>
            <hideGenerationTimestamp>true</hideGenerationTimestamp>
          </configOptions>
        </configuration>
        <executions>
          <execution>
            <id>loan-approval-api</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/loan-approval.yaml</inputSpec>
              <apiPackage>blueprint.workflowmodule.loanapproval.api</apiPackage>
              <modelPackage>blueprint.workflowmodule.loanapproval.api.model</modelPackage>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bpms>camunda7</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda7-adapter-spring-boot</artifactId>
          <version>${camunda7-adapter.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <bpms>camunda8</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda8-adapter-spring-boot</artifactId>
          <version>${camunda8-adapter.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>operaton</id>
      <properties>
        <bpms>operaton</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>operaton-adapter-spring-boot</artifactId>
          <version>${operaton-adapter.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>cibseven</id>
      <properties>
        <bpms>cibseven</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>cibseven-adapter-spring-boot</artifactId>
          <version>${cibseven-adapter.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
