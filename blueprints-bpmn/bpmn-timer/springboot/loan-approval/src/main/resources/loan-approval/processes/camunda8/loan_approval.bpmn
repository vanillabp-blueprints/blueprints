<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_loan_approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="loan_approval" name="Loan approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent_LoanRequested" name="Loan requested">
      <bpmn:outgoing>Flow_ToRetrieveCreditRating</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRetrieveCreditRating" sourceRef="StartEvent_LoanRequested" targetRef="ServiceTask_RetrieveCreditRating" />
    <bpmn:serviceTask id="ServiceTask_RetrieveCreditRating" name="Retrieve credit rating">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="retrieveCreditRating" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRetrieveCreditRating</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCoolOff</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToCoolOff" sourceRef="ServiceTask_RetrieveCreditRating" targetRef="CatchEvent_CoolOff" />
    <!--
      A timer in the sequence flow: the workflow waits here, and nothing in the application
      runs meanwhile. The duration is not written here. It is the getter getCoolOffPeriod of
      the workflow aggregate, which works it out from the amount. So the rule is Java, and
      changing it needs no new process version.
      The customer may withdraw while the workflow waits. The application tells the BPMS
      with aggregateChanged, because the gateway behind the timer reads 'withdrawn'.
    -->
    <bpmn:intermediateCatchEvent id="CatchEvent_CoolOff" name="Cool-off period">
      <bpmn:incoming>Flow_ToCoolOff</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWithdrawn</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_CoolOff">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=coolOffPeriod</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_ToWithdrawn" sourceRef="CatchEvent_CoolOff" targetRef="Gateway_Withdrawn" />
    <!--
      The gateway reads what the BPMS was told last. Nothing of VanillaBP talks to the BPMS
      while the timer waits, so a withdrawal in that time reaches this gateway only because
      the application pushed it with aggregateChanged.
    -->
    <bpmn:exclusiveGateway id="Gateway_Withdrawn" name="Withdrawn?" default="Flow_ToRequestPartnerApproval">
      <bpmn:incoming>Flow_ToWithdrawn</bpmn:incoming>
      <bpmn:outgoing>Flow_ToConfirmWithdrawal</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToRequestPartnerApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToConfirmWithdrawal" name="yes" sourceRef="Gateway_Withdrawn" targetRef="ServiceTask_ConfirmWithdrawal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=withdrawn</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="ServiceTask_ConfirmWithdrawal" name="Confirm withdrawal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="confirmWithdrawal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToConfirmWithdrawal</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoanWithdrawn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLoanWithdrawn" sourceRef="ServiceTask_ConfirmWithdrawal" targetRef="EndEvent_LoanWithdrawn" />
    <bpmn:endEvent id="EndEvent_LoanWithdrawn" name="Loan withdrawn">
      <bpmn:incoming>Flow_ToLoanWithdrawn</bpmn:incoming>
    </bpmn:endEvent>
    <!-- The default flow: taken when nobody withdrew. -->
    <bpmn:sequenceFlow id="Flow_ToRequestPartnerApproval" name="no" sourceRef="Gateway_Withdrawn" targetRef="SendTask_RequestPartnerApproval" />
    <!--
      The asynchronous task, now with a deadline attached. Its job type is the task definition, and the job stays open
      after the handler returned because that handler asks for the task's ID. The process
      waits here until the application completes the task.
    -->
    <bpmn:sendTask id="SendTask_RequestPartnerApproval" name="Request partner approval">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="requestPartnerApproval" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRequestPartnerApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInformCustomer</bpmn:outgoing>
    </bpmn:sendTask>
    <!--
      The way out other than completing: the application cancels the task with this error
      code, and the workflow leaves the user task here.
    -->
    <bpmn:boundaryEvent id="BoundaryEvent_Deadline" name="No answer in time" attachedToRef="SendTask_RequestPartnerApproval">
      <bpmn:outgoing>Flow_ToNoteTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Deadline">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=partnerDeadline</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_ToInformCustomer" sourceRef="SendTask_RequestPartnerApproval" targetRef="ServiceTask_InformCustomer" />
    <bpmn:serviceTask id="ServiceTask_InformCustomer" name="Inform customer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="informCustomer" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToInformCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoanAssessed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLoanAssessed" sourceRef="ServiceTask_InformCustomer" targetRef="EndEvent_LoanAssessed" />
    <bpmn:endEvent id="EndEvent_LoanAssessed" name="Loan assessed">
      <bpmn:incoming>Flow_ToLoanAssessed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToNoteTimeout" sourceRef="BoundaryEvent_Deadline" targetRef="ServiceTask_NoteTimeout" />
    <bpmn:serviceTask id="ServiceTask_NoteTimeout" name="Note the deadline">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="noteTimeout" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNoteTimeout</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoanTimedOut</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLoanTimedOut" sourceRef="ServiceTask_NoteTimeout" targetRef="EndEvent_LoanTimedOut" />
    <bpmn:endEvent id="EndEvent_LoanTimedOut" name="Nobody answered">
      <bpmn:incoming>Flow_ToLoanTimedOut</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loan_approval">
      <bpmndi:BPMNShape id="StartEvent_LoanRequested_di" bpmnElement="StartEvent_LoanRequested">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="134" y="145" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_RetrieveCreditRating_di" bpmnElement="ServiceTask_RetrieveCreditRating">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CatchEvent_CoolOff_di" bpmnElement="CatchEvent_CoolOff">
        <dc:Bounds x="372" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="352" y="145" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask_RequestPartnerApproval_di" bpmnElement="SendTask_RequestPartnerApproval">
        <dc:Bounds x="560" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_InformCustomer_di" bpmnElement="ServiceTask_InformCustomer">
        <dc:Bounds x="720" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanAssessed_di" bpmnElement="EndEvent_LoanAssessed">
        <dc:Bounds x="872" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="859" y="145" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent_Deadline_di" bpmnElement="BoundaryEvent_Deadline">
        <dc:Bounds x="592" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="570" y="185" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_NoteTimeout_di" bpmnElement="ServiceTask_NoteTimeout">
        <dc:Bounds x="720" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanTimedOut_di" bpmnElement="EndEvent_LoanTimedOut">
        <dc:Bounds x="872" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="857" y="305" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToRetrieveCreditRating_di" bpmnElement="Flow_ToRetrieveCreditRating">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCoolOff_di" bpmnElement="Flow_ToCoolOff">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="372" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToWithdrawn_di" bpmnElement="Flow_ToWithdrawn">
        <di:waypoint x="408" y="120" />
        <di:waypoint x="460" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRequestPartnerApproval_di" bpmnElement="Flow_ToRequestPartnerApproval">
        <di:waypoint x="510" y="120" />
        <di:waypoint x="560" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="102" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToInformCustomer_di" bpmnElement="Flow_ToInformCustomer">
        <di:waypoint x="660" y="120" />
        <di:waypoint x="720" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLoanAssessed_di" bpmnElement="Flow_ToLoanAssessed">
        <di:waypoint x="820" y="120" />
        <di:waypoint x="872" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToNoteTimeout_di" bpmnElement="Flow_ToNoteTimeout">
        <di:waypoint x="610" y="178" />
        <di:waypoint x="610" y="280" />
        <di:waypoint x="720" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLoanTimedOut_di" bpmnElement="Flow_ToLoanTimedOut">
        <di:waypoint x="820" y="280" />
        <di:waypoint x="872" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Gateway_Withdrawn_di" bpmnElement="Gateway_Withdrawn" isMarkerVisible="true">
        <dc:Bounds x="460" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="450" y="65" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_ConfirmWithdrawal_di" bpmnElement="ServiceTask_ConfirmWithdrawal">
        <dc:Bounds x="560" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanWithdrawn_di" bpmnElement="EndEvent_LoanWithdrawn">
        <dc:Bounds x="722" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="702" y="445" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToConfirmWithdrawal_di" bpmnElement="Flow_ToConfirmWithdrawal">
        <di:waypoint x="485" y="145" />
        <di:waypoint x="485" y="420" />
        <di:waypoint x="560" y="420" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="491" y="393" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLoanWithdrawn_di" bpmnElement="Flow_ToLoanWithdrawn">
        <di:waypoint x="660" y="420" />
        <di:waypoint x="722" y="420" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
