<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_loan_approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
  <bpmn:process id="loan_approval" name="Loan approval" isExecutable="true" camunda:historyTimeToLive="P30D">
    <bpmn:startEvent id="StartEvent_LoanRequested" name="Loan requested">
      <bpmn:outgoing>Flow_ToRetrieveCreditRating</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRetrieveCreditRating" sourceRef="StartEvent_LoanRequested" targetRef="ServiceTask_RetrieveCreditRating" />
    <bpmn:serviceTask id="ServiceTask_RetrieveCreditRating" name="Retrieve credit rating" camunda:expression="${retrieveCreditRating}">
      <bpmn:incoming>Flow_ToRetrieveCreditRating</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToDecision" sourceRef="ServiceTask_RetrieveCreditRating" targetRef="Gateway_Decision" />
    <!--
      The gateway is not the subject here. It exists so that the process has TWO ends: one
      with work in front of it, one without - which is what makes the difference visible.
    -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Rating good enough?" default="Flow_ToLoanRejected">
      <bpmn:incoming>Flow_ToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInformCustomer</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToLoanRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToInformCustomer" name="yes" sourceRef="Gateway_Decision" targetRef="ServiceTask_InformCustomer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ratedAcceptable}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!--
      THE CLASSIC WAY, and a legitimate one: a task before the end event, because telling
      the customer is work somebody has to do. What it is NOT is a way to learn that the
      workflow ended - it only fires on this branch.
    -->
    <bpmn:serviceTask id="ServiceTask_InformCustomer" name="Inform customer" camunda:expression="${informCustomer}">
      <bpmn:incoming>Flow_ToInformCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoanApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLoanApproved" sourceRef="ServiceTask_InformCustomer" targetRef="EndEvent_LoanApproved" />
    <bpmn:endEvent id="EndEvent_LoanApproved" name="Loan approved">
      <bpmn:incoming>Flow_ToLoanApproved</bpmn:incoming>
    </bpmn:endEvent>
    <!--
      The other end has nothing in front of it, and the application still learns about it:
      that is what the '@WorkflowEnded' method is for. Modelling a task here just to be
      told would be BPMN noise for a fact the engine knows anyway.
    -->
    <bpmn:sequenceFlow id="Flow_ToLoanRejected" name="no" sourceRef="Gateway_Decision" targetRef="EndEvent_LoanRejected" />
    <bpmn:endEvent id="EndEvent_LoanRejected" name="Loan rejected">
      <bpmn:incoming>Flow_ToLoanRejected</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loan_approval">
      <bpmndi:BPMNShape id="StartEvent_LoanRequested_di" bpmnElement="StartEvent_LoanRequested">
        <dc:Bounds x="152" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="134" y="205" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_RetrieveCreditRating_di" bpmnElement="ServiceTask_RetrieveCreditRating">
        <dc:Bounds x="240" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="405" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="392" y="125" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_InformCustomer_di" bpmnElement="ServiceTask_InformCustomer">
        <dc:Bounds x="520" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanApproved_di" bpmnElement="EndEvent_LoanApproved">
        <dc:Bounds x="682" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="663" y="145" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanRejected_di" bpmnElement="EndEvent_LoanRejected">
        <dc:Bounds x="682" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="665" y="265" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToRetrieveCreditRating_di" bpmnElement="Flow_ToRetrieveCreditRating">
        <di:waypoint x="188" y="180" />
        <di:waypoint x="240" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDecision_di" bpmnElement="Flow_ToDecision">
        <di:waypoint x="340" y="180" />
        <di:waypoint x="405" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToInformCustomer_di" bpmnElement="Flow_ToInformCustomer">
        <di:waypoint x="430" y="155" />
        <di:waypoint x="430" y="120" />
        <di:waypoint x="520" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="437" y="133" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLoanApproved_di" bpmnElement="Flow_ToLoanApproved">
        <di:waypoint x="620" y="120" />
        <di:waypoint x="682" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLoanRejected_di" bpmnElement="Flow_ToLoanRejected">
        <di:waypoint x="430" y="205" />
        <di:waypoint x="430" y="240" />
        <di:waypoint x="682" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="440" y="219" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
