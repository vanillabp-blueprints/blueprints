<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.bpmn-user-task-quarkus</groupId>
    <artifactId>bpmn-user-task</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>application</artifactId>
  <name>The application</name>
  <description>The Quarkus application pulling in the workflow module and deciding which BPMS is used.</description>

  <dependencies>
    <dependency>
      <groupId>io.vanillabp.blueprint.bpmn-user-task-quarkus</groupId>
      <artifactId>loan-approval</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      The VanillaBP extension. It belongs into the module which builds the application: it
      wires the business code of every workflow module to the BPMS APIs while the
      application is built.
    -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-quarkus-integration</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <!-- The database is the application's decision, the entity is the module's. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-h2</artifactId>
    </dependency>
    <!-- Configuration in YAML, for application.yaml and for the workflow module's own file. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    This is the only place a BPMS is named: the application decides which adapter is
    loaded. The workflow module does not know and does not care.
  -->
  <profiles>
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.camunda.community.vanillabp</groupId>
          <artifactId>camunda7-adapter-quarkus</artifactId>
          <version>${camunda7-adapter.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <dependencies>
        <dependency>
          <groupId>org.camunda.community.vanillabp</groupId>
          <artifactId>camunda8-adapter-quarkus</artifactId>
          <version>${camunda8-adapter.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
