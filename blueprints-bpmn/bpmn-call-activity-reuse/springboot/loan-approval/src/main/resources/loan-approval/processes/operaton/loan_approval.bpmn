<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_loan_approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
  <!--
    Other processes use the credit check as well, so it is not a call activity. It is a
    collapsed pool: a process of its own with a workflow aggregate of its own, which this model
    shows from the outside only. The two message flows show what goes over and what comes
    back. The engine ignores them. The code behind the service task and the catch event does
    the work.
  -->
  <bpmn:collaboration id="Collaboration_LoanApproval">
    <bpmn:participant id="Participant_LoanApproval" name="Loan approval" processRef="loan_approval" />
    <bpmn:participant id="Participant_CreditCheck" name="Credit check" />
    <bpmn:messageFlow id="MessageFlow_CreditCheckRequested" name="request" sourceRef="ServiceTask_RequestCreditCheck" targetRef="Participant_CreditCheck" />
    <bpmn:messageFlow id="MessageFlow_CreditChecked" name="result" sourceRef="Participant_CreditCheck" targetRef="CatchEvent_CreditChecked" />
  </bpmn:collaboration>
  <bpmn:process id="loan_approval" name="Loan approval" isExecutable="true" camunda:historyTimeToLive="P30D">
    <bpmn:startEvent id="StartEvent_LoanRequested" name="Loan requested">
      <bpmn:outgoing>Flow_ToRequestCreditCheck</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRequestCreditCheck" sourceRef="StartEvent_LoanRequested" targetRef="ServiceTask_RequestCreditCheck" />
    <!-- An ordinary service task. Its handler starts the credit check and returns at once. -->
    <bpmn:serviceTask id="ServiceTask_RequestCreditCheck" name="Request credit check" camunda:expression="${requestCreditCheck}">
      <bpmn:incoming>Flow_ToRequestCreditCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAwaitCreditCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAwaitCreditCheck" sourceRef="ServiceTask_RequestCreditCheck" targetRef="CatchEvent_CreditChecked" />
    <!--
      The workflow waits here for the result. Nothing about the correlation is modelled:
      VanillaBP correlates by the workflow aggregate's ID.
    -->
    <bpmn:intermediateCatchEvent id="CatchEvent_CreditChecked" name="Credit checked">
      <bpmn:incoming>Flow_ToAwaitCreditCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecideOnLoan</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_CreditChecked" messageRef="Message_CreditChecked" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_ToDecideOnLoan" sourceRef="CatchEvent_CreditChecked" targetRef="ServiceTask_DecideOnLoan" />
    <bpmn:serviceTask id="ServiceTask_DecideOnLoan" name="Decide on loan" camunda:expression="${decideOnLoan}">
      <bpmn:incoming>Flow_ToDecideOnLoan</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoanDecided</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLoanDecided" sourceRef="ServiceTask_DecideOnLoan" targetRef="EndEvent_LoanDecided" />
    <bpmn:endEvent id="EndEvent_LoanDecided" name="Loan decided">
      <bpmn:incoming>Flow_ToLoanDecided</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <!-- The message name is the string the business code passes to 'correlateMessage'. -->
  <bpmn:message id="Message_CreditChecked" name="CreditChecked" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_LoanApproval">
      <bpmndi:BPMNShape id="Participant_LoanApproval_di" bpmnElement="Participant_LoanApproval" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="640" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_LoanRequested_di" bpmnElement="StartEvent_LoanRequested">
        <dc:Bounds x="232" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="214" y="195" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_RequestCreditCheck_di" bpmnElement="ServiceTask_RequestCreditCheck">
        <dc:Bounds x="320" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CatchEvent_CreditChecked_di" bpmnElement="CatchEvent_CreditChecked">
        <dc:Bounds x="482" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="463" y="128" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_DecideOnLoan_di" bpmnElement="ServiceTask_DecideOnLoan">
        <dc:Bounds x="570" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanDecided_di" bpmnElement="EndEvent_LoanDecided">
        <dc:Bounds x="722" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="707" y="195" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToRequestCreditCheck_di" bpmnElement="Flow_ToRequestCreditCheck">
        <di:waypoint x="268" y="170" />
        <di:waypoint x="320" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToAwaitCreditCheck_di" bpmnElement="Flow_ToAwaitCreditCheck">
        <di:waypoint x="420" y="170" />
        <di:waypoint x="482" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDecideOnLoan_di" bpmnElement="Flow_ToDecideOnLoan">
        <di:waypoint x="518" y="170" />
        <di:waypoint x="570" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLoanDecided_di" bpmnElement="Flow_ToLoanDecided">
        <di:waypoint x="670" y="170" />
        <di:waypoint x="722" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_CreditCheck_di" bpmnElement="Participant_CreditCheck" isHorizontal="true">
        <dc:Bounds x="160" y="330" width="640" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="MessageFlow_CreditCheckRequested_di" bpmnElement="MessageFlow_CreditCheckRequested">
        <di:waypoint x="370" y="210" />
        <di:waypoint x="370" y="330" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="378" y="263" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_CreditChecked_di" bpmnElement="MessageFlow_CreditChecked">
        <di:waypoint x="500" y="330" />
        <di:waypoint x="500" y="188" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="508" y="263" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
