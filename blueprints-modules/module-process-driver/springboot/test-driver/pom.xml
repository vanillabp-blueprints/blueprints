<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.module-process-driver-springboot</groupId>
    <artifactId>module-process-driver</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>test-driver</artifactId>
  <name>The process driver of 'loan-approval'</name>
  <description>Brings a loan approval to a named point of its process, through the business code of the workflow module and the test API of the simulator. It is a module of its own, so the application in production never has it. Its tests are the tests of the workflow module.</description>

  <properties>
    <!-- '-DskipTests' starts no simulator either. -->
    <skipTests>false</skipTests>
  </properties>

  <dependencies>
    <!--
      The driver goes through the business code of the module, as a user does through its API.
      It reads the aggregates through the module's repository. It never talks to a BPMS.
    -->
    <dependency>
      <groupId>io.vanillabp.blueprint.module-process-driver-springboot</groupId>
      <artifactId>loan-approval</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The client of the simulator's test API, generated from its OpenAPI file. -->
    <dependency>
      <groupId>io.vanillabp.blueprint.module-process-driver-springboot</groupId>
      <artifactId>simulator-test-api-client</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <!-- The driver waits for the application to reach a state. -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      These tests are the tests of the workflow module. They run it with a database, a BPMS
      adapter, a cockpit adapter and the REST adapters of the ports. The adapters talk to the
      simulator, which the build starts. Nothing is mocked.
    -->
    <dependency>
      <groupId>io.vanillabp.blueprint.module-process-driver-springboot</groupId>
      <artifactId>credit-rating-rest-adapter</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vanillabp.blueprint.module-process-driver-springboot</groupId>
      <artifactId>e-signature-rest-adapter</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!--
      Only for the order of the build: the simulator has to be built before these tests run.
      Putting it first in the parent's <modules> is not enough. Maven sorts the modules by their
      dependencies and keeps the order of <modules> only between modules which do not depend on
      each other, and a parallel build ('-T') builds such modules at the same time. Only this
      dependency makes Maven wait for the simulator's JAR, and only this dependency brings the
      simulator into 'mvn -pl test-driver -am'.

      It puts nothing on a classpath: the type 'pom' adds no JAR, and the exclusion keeps the
      simulator's own dependencies away. The tests talk to the simulator over HTTP, as the
      application does.
    -->
    <dependency>
      <groupId>io.vanillabp.blueprint.module-process-driver-springboot</groupId>
      <artifactId>simulator</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The REST API of the driver is written as the OpenAPI file
        'src/main/resources/openapi/process-driver.yaml'. Only a browser, the dev shell and the
        tests of a user interface call it, so it has no client module. 'ProcessDriverController'
        implements the interface generated from it.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>process-driver-api</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/process-driver.yaml</inputSpec>
              <apiPackage>blueprint.testdriver.loanapproval.api</apiPackage>
              <modelPackage>blueprint.testdriver.loanapproval.api.model</modelPackage>
              <configOptions>
                <!-- Only the interface. The controller implements it. -->
                <interfaceOnly>true</interfaceOnly>
                <skipDefaultInterface>true</skipDefaultInterface>
                <!-- The paths in the file are complete, so the interface needs no path of its own. -->
                <requestMappingMode>none</requestMappingMode>
                <!-- A method returns the answer itself. Spring Boot turns it into the response. -->
                <useResponseEntity>false</useResponseEntity>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        The next four plugins start the simulator before the integration tests, on a free port,
        and tell the tests where it is. Its log goes to target/simulator.log, and a failing test
        prints what the simulator logged meanwhile. The simulator ends with the build.

        This is the plain build and not a profile which switches itself on. Such a profile
        would switch off 'camunda7', the BPMS profile which is active by default, and a build
        without '-P<bpms>' would have no BPMS adapter.

        To run the tests against a simulator you started yourself, for example while you debug
        it, name its address. The build still starts its own simulator, and the tests use yours:

          mvn -pl simulator spring-boot:run
          mvn verify -Dsimulator.base-url=http://localhost:8079

        A test run from the IDE has none of this. It looks for a simulator at
        http://localhost:8079 and skips, with a message, when nobody answers.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>simulator-port</id>
            <goals>
              <goal>reserve-network-port</goal>
            </goals>
            <phase>initialize</phase>
            <configuration>
              <portNames>
                <portName>simulator.port</portName>
              </portNames>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        The runnable JAR of the simulator, from this build, copied to target/. It is not a
        dependency of the tests, because it is a whole application.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>simulator-jar</id>
            <goals>
              <goal>copy</goal>
            </goals>
            <phase>pre-integration-test</phase>
            <configuration>
              <skip>${skipTests}</skip>
              <artifactItems>
                <artifactItem>
                  <groupId>io.vanillabp.blueprint.module-process-driver-springboot</groupId>
                  <artifactId>simulator</artifactId>
                  <version>${project.version}</version>
                  <classifier>runnable</classifier>
                  <destFileName>simulator.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        Starts the simulator and goes on at once. The tests wait until it answers. Maven
        stops it when the build ends, also when the build fails. Its log goes to a file and
        not to the console, so the build output stays readable.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>start-simulator</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>pre-integration-test</phase>
            <configuration>
              <skip>${skipTests}</skip>
              <async>true</async>
              <asyncDestroyOnShutdown>true</asyncDestroyOnShutdown>
              <executable>${java.home}/bin/java</executable>
              <arguments>
                <argument>-jar</argument>
                <argument>${project.build.directory}/simulator.jar</argument>
                <argument>--server.port=${simulator.port}</argument>
                <argument>--logging.file.name=${project.build.directory}/simulator.log</argument>
                <argument>--logging.threshold.console=OFF</argument>
                <argument>--spring.main.banner-mode=off</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <simulator.base-url>http://localhost:${simulator.port}</simulator.base-url>
            <simulator.log>${project.build.directory}/simulator.log</simulator.log>
            <!-- The build started the simulator, so a test which finds none fails instead of skipping. -->
            <simulator.required>true</simulator.required>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      One profile per BPMS. Each adds two adapters to the test: the BPMS adapter, which runs
      the workflows, and the cockpit adapter of the same BPMS, which reports their user tasks
      to the cockpit. The application declares the same two.
    -->
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bpms>camunda7</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda7-adapter-spring-boot</artifactId>
          <version>${camunda7-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-camunda7-adapter-spring-boot</artifactId>
          <version>${businesscockpit.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <bpms>camunda8</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda8-adapter-spring-boot</artifactId>
          <version>${camunda8-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-camunda8-adapter-spring-boot</artifactId>
          <version>${businesscockpit-camunda8.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>operaton</id>
      <properties>
        <bpms>operaton</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>operaton-adapter-spring-boot</artifactId>
          <version>${operaton-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-operaton-adapter-spring-boot</artifactId>
          <version>${businesscockpit.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>cibseven</id>
      <properties>
        <bpms>cibseven</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>cibseven-adapter-spring-boot</artifactId>
          <version>${cibseven-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-cibseven-adapter-spring-boot</artifactId>
          <version>${businesscockpit.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
