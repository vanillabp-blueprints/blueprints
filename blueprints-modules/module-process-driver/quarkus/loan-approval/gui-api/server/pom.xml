<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.module-process-driver-quarkus</groupId>
    <artifactId>loan-approval-gui-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>loan-approval-gui-api-server</artifactId>
  <name>API of the user interface of 'loan-approval': server</name>
  <description>The interface of the API of the user interface, generated from loan-approval.yaml. The workflow module implements it.</description>

  <!--
    Only what the generated sources import: the annotations of Jakarta REST, of Jackson and of
    Jakarta. No Quarkus extension, so the module stays a small library.
  -->
  <dependencies>
    <dependency>
      <groupId>jakarta.ws.rs</groupId>
      <artifactId>jakarta.ws.rs-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Generates the Java interface 'LoanApprovalApi' and the classes of its answers from
        '../loan-approval.yaml'. 'ApiController' of the workflow module implements the interface
        and holds nothing but the code of each call.
        The settings all generated code shares are in the POM of the blueprint.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>loan-approval-gui-api-server</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../loan-approval.yaml</inputSpec>
              <apiPackage>blueprint.workflowmodule.loanapproval.api.server</apiPackage>
              <modelPackage>blueprint.workflowmodule.loanapproval.api.server.model</modelPackage>
              <configOptions>
                <!-- A method returns the answer itself. Quarkus turns it into the response. -->
                <returnResponse>false</returnResponse>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        Quarkus REST reads the paths and the parameters from the generated interface, which
        'ApiController' implements. It finds the interface only in an index of this JAR.
      -->
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>make-index</id>
            <goals>
              <goal>jandex</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
