<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_loan_approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
  <bpmn:process id="loan_approval" name="Loan approval" isExecutable="true" camunda:historyTimeToLive="P30D">
    <bpmn:startEvent id="StartEvent_LoanRequested" name="Loan requested">
      <bpmn:outgoing>Flow_ToRiskDecision</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRiskDecision" sourceRef="StartEvent_LoanRequested" targetRef="Gateway_RiskAssessmentNeeded" />
    <!--
      The gateway asks the aggregate a question. The business code answered it when the loan
      was requested, so the limit is configuration of the module and not part of the model.
    -->
    <bpmn:exclusiveGateway id="Gateway_RiskAssessmentNeeded" name="Risk assessment needed?" default="Flow_NoRiskAssessment">
      <bpmn:incoming>Flow_ToRiskDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAssessRisk</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoRiskAssessment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToAssessRisk" name="large amount" sourceRef="Gateway_RiskAssessmentNeeded" targetRef="UserTask_AssessRisk">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${riskAssessmentNeeded}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoRiskAssessment" name="otherwise" sourceRef="Gateway_RiskAssessmentNeeded" targetRef="Gateway_RiskAssessed" />
    <!--
      A user task, which the cockpit adapter reports to the Business Cockpit. The form key is
      the task definition: the @WorkflowTask method of that name is called when the task is
      created, and the cockpit knows the task by the same name.
    -->
    <bpmn:userTask id="UserTask_AssessRisk" name="Assess risk" camunda:formKey="assessRisk">
      <bpmn:incoming>Flow_ToAssessRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_FromAssessRisk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_FromAssessRisk" sourceRef="UserTask_AssessRisk" targetRef="Gateway_RiskAssessed" />
    <bpmn:exclusiveGateway id="Gateway_RiskAssessed">
      <bpmn:incoming>Flow_NoRiskAssessment</bpmn:incoming>
      <bpmn:incoming>Flow_FromAssessRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendContractForSigning</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToSendContractForSigning" sourceRef="Gateway_RiskAssessed" targetRef="ServiceTask_SendContractForSigning" />
    <!-- Hands the contract to the e-signature service. The signature or the decline comes later, as a callback. -->
    <bpmn:serviceTask id="ServiceTask_SendContractForSigning" name="Send contract for signing" camunda:expression="${sendContractForSigning}">
      <bpmn:incoming>Flow_ToSendContractForSigning</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCheckContract</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToCheckContract" sourceRef="ServiceTask_SendContractForSigning" targetRef="UserTask_CheckContract" />
    <!--
      Somebody checks the signed contract. The task opens while the signature may still be on
      its way. The business code refuses to complete it before the signature is there.
    -->
    <bpmn:userTask id="UserTask_CheckContract" name="Check contract" camunda:formKey="checkContract">
      <bpmn:incoming>Flow_ToCheckContract</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoanApproved</bpmn:outgoing>
    </bpmn:userTask>
    <!--
      The customer declined to sign. The e-signature service reports it, and the application
      correlates the message. There is nothing left to check, so the task "Check contract" ends
      here, and the loan is declined. Nothing about the correlation is modelled: the adapter adds
      the subscription by the id of the workflow aggregate itself.
    -->
    <bpmn:boundaryEvent id="BoundaryEvent_ContractDeclined" name="Contract declined" attachedToRef="UserTask_CheckContract">
      <bpmn:outgoing>Flow_ToLoanDeclined</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ContractDeclined" messageRef="Message_ContractDeclined" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_ToLoanDeclined" sourceRef="BoundaryEvent_ContractDeclined" targetRef="EndEvent_LoanDeclined" />
    <bpmn:endEvent id="EndEvent_LoanDeclined" name="Loan declined">
      <bpmn:incoming>Flow_ToLoanDeclined</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToLoanApproved" sourceRef="UserTask_CheckContract" targetRef="EndEvent_LoanApproved" />
    <bpmn:endEvent id="EndEvent_LoanApproved" name="Loan approved">
      <bpmn:incoming>Flow_ToLoanApproved</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <!-- The message name is the string the business code passes to 'correlateMessage'. -->
  <bpmn:message id="Message_ContractDeclined" name="ContractDeclined" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loan_approval">
      <bpmndi:BPMNShape id="StartEvent_LoanRequested_di" bpmnElement="StartEvent_LoanRequested">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="134" y="145" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RiskAssessmentNeeded_di" bpmnElement="Gateway_RiskAssessmentNeeded" isMarkerVisible="true">
        <dc:Bounds x="235" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="218" y="58" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_AssessRisk_di" bpmnElement="UserTask_AssessRisk">
        <dc:Bounds x="330" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RiskAssessed_di" bpmnElement="Gateway_RiskAssessed" isMarkerVisible="true">
        <dc:Bounds x="480" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_SendContractForSigning_di" bpmnElement="ServiceTask_SendContractForSigning">
        <dc:Bounds x="570" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_CheckContract_di" bpmnElement="UserTask_CheckContract">
        <dc:Bounds x="730" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanApproved_di" bpmnElement="EndEvent_LoanApproved">
        <dc:Bounds x="892" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="875" y="145" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent_ContractDeclined_di" bpmnElement="BoundaryEvent_ContractDeclined">
        <dc:Bounds x="762" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="790" y="185" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanDeclined_di" bpmnElement="EndEvent_LoanDeclined">
        <dc:Bounds x="892" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="876" y="255" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToRiskDecision_di" bpmnElement="Flow_ToRiskDecision">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="235" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToAssessRisk_di" bpmnElement="Flow_ToAssessRisk">
        <di:waypoint x="260" y="145" />
        <di:waypoint x="260" y="230" />
        <di:waypoint x="330" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="266" y="236" width="62" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoRiskAssessment_di" bpmnElement="Flow_NoRiskAssessment">
        <di:waypoint x="285" y="120" />
        <di:waypoint x="480" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="353" y="102" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FromAssessRisk_di" bpmnElement="Flow_FromAssessRisk">
        <di:waypoint x="430" y="230" />
        <di:waypoint x="505" y="230" />
        <di:waypoint x="505" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToSendContractForSigning_di" bpmnElement="Flow_ToSendContractForSigning">
        <di:waypoint x="530" y="120" />
        <di:waypoint x="570" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCheckContract_di" bpmnElement="Flow_ToCheckContract">
        <di:waypoint x="670" y="120" />
        <di:waypoint x="730" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLoanApproved_di" bpmnElement="Flow_ToLoanApproved">
        <di:waypoint x="830" y="120" />
        <di:waypoint x="892" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLoanDeclined_di" bpmnElement="Flow_ToLoanDeclined">
        <di:waypoint x="780" y="178" />
        <di:waypoint x="780" y="230" />
        <di:waypoint x="892" y="230" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
