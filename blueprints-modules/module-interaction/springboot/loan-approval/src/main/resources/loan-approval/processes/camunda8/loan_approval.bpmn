<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_loan_approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="loan_approval" name="Loan approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent_LoanRequested" name="Loan requested">
      <bpmn:outgoing>Flow_ToRetrieveCreditRating</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRetrieveCreditRating" sourceRef="StartEvent_LoanRequested" targetRef="ServiceTask_RetrieveCreditRating" />
    <!-- The task definition names the method of the @WorkflowTask. -->
    <bpmn:serviceTask id="ServiceTask_RetrieveCreditRating" name="Retrieve credit rating">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="retrieveCreditRating" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRetrieveCreditRating</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRequestRiskAssessment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRequestRiskAssessment" sourceRef="ServiceTask_RetrieveCreditRating" targetRef="ServiceTask_RequestRiskAssessment" />
    <!-- Asking the other workflow module is an ordinary task of this process. What the handler does with it - here: call an interface that module offers - is not modelled, and must not be. -->
    <bpmn:serviceTask id="ServiceTask_RequestRiskAssessment" name="Request risk assessment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="requestRiskAssessment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRequestRiskAssessment</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAwaitRiskAssessment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAwaitRiskAssessment" sourceRef="ServiceTask_RequestRiskAssessment" targetRef="CatchEvent_RiskAssessed" />
    <!--
      The process waits here until the answer arrives. Nothing about the correlation is
      modelled: the adapter subscribes by the workflow aggregate's ID while deploying, so
      the model stays free of it - and free of any hint who answers.
    -->
    <bpmn:intermediateCatchEvent id="CatchEvent_RiskAssessed" name="Risk assessed">
      <bpmn:incoming>Flow_ToAwaitRiskAssessment</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoanAssessed</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_RiskAssessed" messageRef="Message_RiskAssessed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_ToLoanAssessed" sourceRef="CatchEvent_RiskAssessed" targetRef="EndEvent_LoanAssessed" />
    <bpmn:endEvent id="EndEvent_LoanAssessed" name="Loan assessed">
      <bpmn:incoming>Flow_ToLoanAssessed</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <!-- The message name is the string the business code passes to 'correlateMessage'. -->
  <bpmn:message id="Message_RiskAssessed" name="RiskAssessed" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loan_approval">
      <bpmndi:BPMNShape id="StartEvent_LoanRequested_di" bpmnElement="StartEvent_LoanRequested">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="134" y="145" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_RetrieveCreditRating_di" bpmnElement="ServiceTask_RetrieveCreditRating">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_RequestRiskAssessment_di" bpmnElement="ServiceTask_RequestRiskAssessment">
        <dc:Bounds x="400" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CatchEvent_RiskAssessed_di" bpmnElement="CatchEvent_RiskAssessed">
        <dc:Bounds x="562" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="544" y="145" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanAssessed_di" bpmnElement="EndEvent_LoanAssessed">
        <dc:Bounds x="650" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="632" y="145" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToRetrieveCreditRating_di" bpmnElement="Flow_ToRetrieveCreditRating">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRequestRiskAssessment_di" bpmnElement="Flow_ToRequestRiskAssessment">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="400" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToAwaitRiskAssessment_di" bpmnElement="Flow_ToAwaitRiskAssessment">
        <di:waypoint x="500" y="120" />
        <di:waypoint x="562" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLoanAssessed_di" bpmnElement="Flow_ToLoanAssessed">
        <di:waypoint x="598" y="120" />
        <di:waypoint x="650" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
