<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.module-simulator-quarkus</groupId>
    <artifactId>credit-rating-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>credit-rating-api-client</artifactId>
  <name>API 'credit rating': client</name>
  <description>The client of the credit rating, generated from credit-rating.yaml. The application uses it.</description>

  <!--
    Only what the generated sources import: the annotations of Jakarta REST, of Jackson and of
    Jakarta. No Quarkus extension, so the module stays a small library.
  -->
  <dependencies>
    <dependency>
      <groupId>jakarta.ws.rs</groupId>
      <artifactId>jakarta.ws.rs-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Generates the client of the credit rating from '../credit-rating.yaml'. The REST adapter
        of the application uses it.
        The settings all generated code shares are in the POM of the blueprint.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>credit-rating-client</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../credit-rating.yaml</inputSpec>
              <apiPackage>blueprint.externalsystems.creditrating.api.client</apiPackage>
              <modelPackage>blueprint.externalsystems.creditrating.api.client.model</modelPackage>
              <configOptions>
                <!-- The method returns the body. An error status comes as an exception of the REST client. -->
                <returnResponse>false</returnResponse>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        The REST client of Quarkus implements the generated interface while the application is
        built. It finds the interface only in an index of this JAR.
      -->
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>make-index</id>
            <goals>
              <goal>jandex</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
