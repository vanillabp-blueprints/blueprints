<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.module-simulator-quarkus</groupId>
    <artifactId>e-signature-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>e-signature-api-client</artifactId>
  <name>API 'e-signature': client</name>
  <description>What the application needs of the e-signature service, generated: the client of e-signature.yaml and the interface of e-signature-callback.yaml.</description>

  <!--
    Only what the generated sources import: the annotations of Jakarta REST, of Jackson and of
    Jakarta. No Quarkus extension, so the module stays a small library.
  -->
  <dependencies>
    <dependency>
      <groupId>jakarta.ws.rs</groupId>
      <artifactId>jakarta.ws.rs-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Generates what the application needs: the client of '../e-signature.yaml', which hands a
        contract over, and the interface of '../e-signature-callback.yaml', which the REST
        adapter implements to take the callback.
        The settings all generated code shares are in the POM of the blueprint.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>e-signature-client</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../e-signature.yaml</inputSpec>
              <apiPackage>blueprint.externalsystems.esignature.api.client</apiPackage>
              <modelPackage>blueprint.externalsystems.esignature.api.client.model</modelPackage>
              <configOptions>
                <!-- The method returns the body. An error status comes as an exception of the REST client. -->
                <returnResponse>false</returnResponse>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>e-signature-callback-server</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../e-signature-callback.yaml</inputSpec>
              <apiPackage>blueprint.externalsystems.esignature.callback.server</apiPackage>
              <modelPackage>blueprint.externalsystems.esignature.callback.server.model</modelPackage>
              <configOptions>
                <!-- The method returns the whole answer, because the receiver decides its status. -->
                <returnResponse>true</returnResponse>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        The REST client and the REST server of Quarkus find the generated interfaces while the
        application is built, and only in an index of this JAR.
      -->
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>make-index</id>
            <goals>
              <goal>jandex</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
