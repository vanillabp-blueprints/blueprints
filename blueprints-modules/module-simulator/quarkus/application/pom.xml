<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.module-simulator-quarkus</groupId>
    <artifactId>module-simulator</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>application</artifactId>
  <name>The application</name>
  <description>The Quarkus application: the workflow module, the adapters of its ports and the adapters of the BPMS and the cockpit. A profile decides whether the adapters talk to the simulator or to the real systems.</description>

  <dependencies>
    <!-- The workflow module. Quarkus finds it through the index its build writes. -->
    <dependency>
      <groupId>io.vanillabp.blueprint.module-simulator-quarkus</groupId>
      <artifactId>loan-approval</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      The adapters of the module's ports. The application chooses them, as it chooses the
      BPMS adapter. Another adapter for the same port, for another product, is a change of
      this list and not of the workflow module.
    -->
    <dependency>
      <groupId>io.vanillabp.blueprint.module-simulator-quarkus</groupId>
      <artifactId>credit-rating-rest-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.vanillabp.blueprint.module-simulator-quarkus</groupId>
      <artifactId>e-signature-rest-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      The VanillaBP extension. It belongs into the module which builds the application: it
      wires the business code of every workflow module to the BPMS APIs while the
      application is built.
    -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-quarkus-integration</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <!-- The database is the application's decision, the entity is the module's. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-h2</artifactId>
    </dependency>
    <!-- Configuration in YAML, for application.yaml and for the workflow module's own file. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    The one line of build machinery this blueprint needs: 'application.yaml' names the BPMS
    profile of the build, and only Maven knows it. Filtering is restricted to that file, and
    to the '@...@' delimiters, so nothing else in the resources is touched and Quarkus' own
    '${...}' expressions keep working.
  -->
  <build>
    <resources>
      <resource>
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
        <includes>
          <include>application*.yaml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>application*.yaml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <configuration>
          <delimiters>
            <delimiter>@</delimiter>
          </delimiters>
          <useDefaultDelimiters>false</useDefaultDelimiters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        The application brings the adapters, so the rule of the parent POM which keeps them
        out of a workflow module is switched off here.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-adapter-in-a-workflow-module</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <!--
        Two profiles are parents in a test: the BPMS profile, as everywhere, and the profile of
        the systems around the application. The smoke test runs with 'local', like a developer.
        The integration test runs with 'real' and with addresses where nothing answers, so it
        sees what a user sees when a system is missing.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <quarkus.config.profile.parent>${bpms},local</quarkus.config.profile.parent>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <quarkus.config.profile.parent>${bpms},real</quarkus.config.profile.parent>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    This is the only place a BPMS is named: the application decides which adapters are
    loaded. Per BPMS there are two: the BPMS adapter, which runs the workflows, and the cockpit
    adapter of the same BPMS, which reports their user tasks to the Business Cockpit. The
    workflow module does not know and does not care.
  -->
  <profiles>
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bpms>camunda7</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda7-adapter-quarkus</artifactId>
          <version>${camunda7-adapter.version}</version>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-camunda7-adapter-quarkus</artifactId>
          <version>${businesscockpit.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <bpms>camunda8</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda8-adapter-quarkus</artifactId>
          <version>${camunda8-adapter.version}</version>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-camunda8-adapter-quarkus</artifactId>
          <version>${businesscockpit-camunda8.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>operaton</id>
      <properties>
        <bpms>operaton</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>operaton-adapter-quarkus</artifactId>
          <version>${operaton-adapter.version}</version>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-operaton-adapter-quarkus</artifactId>
          <version>${businesscockpit.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>cibseven</id>
      <properties>
        <bpms>cibseven</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>cibseven-adapter-quarkus</artifactId>
          <version>${cibseven-adapter.version}</version>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-cibseven-adapter-quarkus</artifactId>
          <version>${businesscockpit.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
