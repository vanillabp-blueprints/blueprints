<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.module-simulator-springboot</groupId>
    <artifactId>module-simulator</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>loan-approval</artifactId>
  <name>Workflow module 'loan-approval'</name>
  <description>The workflow module: BPMN models and the code implementing them, packaged as a JAR. It knows the systems around it only through their ports.</description>

  <dependencies>
    <!--
      The workflow module knows the VanillaBP APIs, but no BPMS: 'vanillabp-spring-boot-support'
      deliberately does not expose any BPMS API, so the hexagonal architecture cannot be
      broken by accident. The adapter is chosen by the application (see ../application).
    -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-spring-boot-support</artifactId>
    </dependency>
    <!--
      The same for the Business Cockpit: its annotations, such as @UserTaskDetailsProvider. It
      knows no BPMS either. The cockpit adapter of the BPMS is chosen by the application, next
      to the BPMS adapter.
    -->
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>support</artifactId>
      <version>${businesscockpit.version}</version>
    </dependency>
    <!--
      The systems around the module, as ports: interfaces named after the role each system
      plays. Not the adapters. Which adapter implements a port is the choice of the
      application, like the choice of the BPMS adapter.
    -->
    <dependency>
      <groupId>io.vanillabp.blueprint.module-simulator-springboot</groupId>
      <artifactId>credit-rating-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.vanillabp.blueprint.module-simulator-springboot</groupId>
      <artifactId>e-signature-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      Testing the workflow module means running it: the test sources bring their own tiny
      Spring Boot application (ModuleTestApplication), a database, a BPMS adapter, a cockpit
      adapter and the REST adapters of the ports. The adapters talk to the simulator, which
      the build starts. Nothing is mocked.
    -->
    <dependency>
      <groupId>io.vanillabp.blueprint.module-simulator-springboot</groupId>
      <artifactId>credit-rating-rest-adapter</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vanillabp.blueprint.module-simulator-springboot</groupId>
      <artifactId>e-signature-rest-adapter</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!--
      Only for the order of the build: the simulator has to be built before these tests run.
      The exclusion keeps every class of the simulator off the classpath of the tests. The
      tests talk to the simulator over HTTP, as the application does.
    -->
    <dependency>
      <groupId>io.vanillabp.blueprint.module-simulator-springboot</groupId>
      <artifactId>simulator</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!--
      Starts the simulator before the integration tests, on a free port, and tells the tests
      where it is. Its log goes to target/simulator.log, and a failing test prints what the
      simulator logged meanwhile. The simulator ends with the build.

      The profile is on unless 'simulator.base-url' is given. Pass that to run the tests
      against a simulator you started yourself, for example while you debug it:

        mvn -pl simulator spring-boot:run
        mvn verify -Dsimulator.base-url=http://localhost:8079

      A test run from the IDE has no profile at all. It looks for a simulator at
      http://localhost:8079 and skips, with a message, when nobody answers.
    -->
    <profile>
      <id>start-stop-simulator</id>
      <activation>
        <property>
          <name>!simulator.base-url</name>
        </property>
      </activation>
      <properties>
        <!-- '-DskipTests' starts no simulator either. -->
        <skipTests>false</skipTests>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>simulator-port</id>
                <goals>
                  <goal>reserve-network-port</goal>
                </goals>
                <phase>initialize</phase>
                <configuration>
                  <portNames>
                    <portName>simulator.port</portName>
                  </portNames>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!--
            The runnable JAR of the simulator, from this build, copied to target/. It is not a
            dependency of the tests, because it is a whole application.
          -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>simulator-jar</id>
                <goals>
                  <goal>copy</goal>
                </goals>
                <phase>pre-integration-test</phase>
                <configuration>
                  <skip>${skipTests}</skip>
                  <artifactItems>
                    <artifactItem>
                      <groupId>io.vanillabp.blueprint.module-simulator-springboot</groupId>
                      <artifactId>simulator</artifactId>
                      <version>${project.version}</version>
                      <classifier>runnable</classifier>
                      <destFileName>simulator.jar</destFileName>
                    </artifactItem>
                  </artifactItems>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!--
            Starts the simulator and goes on at once. The tests wait until it answers. Maven
            stops it when the build ends, also when the build fails. Its log goes to a file and
            not to the console, so the build output stays readable.
          -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.7.0</version>
            <executions>
              <execution>
                <id>start-simulator</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>pre-integration-test</phase>
                <configuration>
                  <skip>${skipTests}</skip>
                  <async>true</async>
                  <asyncDestroyOnShutdown>true</asyncDestroyOnShutdown>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-jar</argument>
                    <argument>${project.build.directory}/simulator.jar</argument>
                    <argument>--server.port=${simulator.port}</argument>
                    <argument>--logging.file.name=${project.build.directory}/simulator.log</argument>
                    <argument>--logging.threshold.console=OFF</argument>
                    <argument>--spring.main.banner-mode=off</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <simulator.base-url>http://localhost:${simulator.port}</simulator.base-url>
                <simulator.log>${project.build.directory}/simulator.log</simulator.log>
                <!-- The build started the simulator, so a test which finds none fails instead of skipping. -->
                <simulator.required>true</simulator.required>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      One profile per BPMS. Each adds two adapters to the test: the BPMS adapter, which runs
      the workflows, and the cockpit adapter of the same BPMS, which reports their user tasks
      to the cockpit. The application declares the same two.
    -->
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bpms>camunda7</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda7-adapter-spring-boot</artifactId>
          <version>${camunda7-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-camunda7-adapter-spring-boot</artifactId>
          <version>${businesscockpit.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <bpms>camunda8</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda8-adapter-spring-boot</artifactId>
          <version>${camunda8-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-camunda8-adapter-spring-boot</artifactId>
          <version>${businesscockpit-camunda8.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>operaton</id>
      <properties>
        <bpms>operaton</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>operaton-adapter-spring-boot</artifactId>
          <version>${operaton-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-operaton-adapter-spring-boot</artifactId>
          <version>${businesscockpit.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>cibseven</id>
      <properties>
        <bpms>cibseven</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>cibseven-adapter-spring-boot</artifactId>
          <version>${cibseven-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-cibseven-adapter-spring-boot</artifactId>
          <version>${businesscockpit.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
