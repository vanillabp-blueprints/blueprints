<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.module-simulator-springboot</groupId>
    <artifactId>credit-rating-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>credit-rating-api-client</artifactId>
  <name>API 'credit rating': client</name>
  <description>The client of the credit rating, generated from credit-rating.yaml. The application uses it.</description>

  <!--
    What the generated sources import, the annotations of Jackson and of Jakarta, and the
    support library of the Business Cockpit, which brings the HTTP service clients of Spring and
    builds the client of this module from keys.
  -->
  <dependencies>
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>business-cockpit-spring-boot-support</artifactId>
      <version>${businesscockpit.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Generates the client of the credit rating from '../credit-rating.yaml'. The REST adapter
        of the application uses it.
        The settings all generated code shares are in the POM of the blueprint.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>credit-rating-client</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../credit-rating.yaml</inputSpec>
              <apiPackage>blueprint.externalsystems.creditrating.api.client</apiPackage>
              <modelPackage>blueprint.externalsystems.creditrating.api.client.model</modelPackage>
              <!-- A Spring HTTP interface. Whoever calls the API turns it into a client with a RestClient. -->
              <library>spring-http-interface</library>
              <configOptions>
                <!-- The method returns the body. An error status comes as an exception of the RestClient. -->
                <useResponseEntity>false</useResponseEntity>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
