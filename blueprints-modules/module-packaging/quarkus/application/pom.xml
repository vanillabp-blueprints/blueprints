<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.module-packaging-quarkus</groupId>
    <artifactId>module-packaging</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>application</artifactId>
  <name>The application</name>
  <description>The Quarkus application collecting both workflow modules and deciding which BPMS is used.</description>

  <!--
    One place naming the version of every workflow module in this runtime. A module release is
    a line changed here, and nothing in the application's code moves with it.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.acme.lending</groupId>
        <artifactId>loan-approval</artifactId>
        <version>1.4.0</version>
      </dependency>
      <dependency>
        <groupId>com.acme.lending</groupId>
        <artifactId>loan-repayment</artifactId>
        <version>2.1.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      The two workflow modules. This is everything the application says about them: no
      configuration, no knowledge of their packages - each module carries the index which
      makes its classes visible.
    -->
    <dependency>
      <groupId>com.acme.lending</groupId>
      <artifactId>loan-approval</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.lending</groupId>
      <artifactId>loan-repayment</artifactId>
    </dependency>
    <!--
      The VanillaBP extension. It belongs into the module which builds the application: it
      wires the business code of every workflow module to the BPMS APIs while the
      application is built.
    -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-quarkus-integration</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <!-- The database is the application's decision, the entity is the module's. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-h2</artifactId>
    </dependency>
    <!-- Configuration in YAML, for application.yaml and for the workflow module's own file. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <!--
      Builds the container image of this runtime, on demand rather than on every build:
      '-Dquarkus.container-image.build=true'. Jib needs no Docker daemon to assemble it.
    -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-container-image-jib</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    The one line of build machinery this blueprint needs: 'application.yaml' names the BPMS
    profile of the build, and only Maven knows it. Filtering is restricted to that file, and
    to the '@...@' delimiters, so nothing else in the resources is touched and Quarkus' own
    '${...}' expressions keep working.
  -->
  <build>
    <resources>
      <resource>
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
        <includes>
          <include>application*.yaml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>application*.yaml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <!--
        What a deployment sets from outside, here as a system property so a test can read it:
        it wins over the module's own file and over application.yaml. In a container this
        would be the environment variable LOAN_APPROVAL_RATING_PROVIDER.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <quarkus.config.profile.parent>${bpms}</quarkus.config.profile.parent>
            <loan-approval.rating-provider>from-the-environment</loan-approval.rating-provider>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <configuration>
          <delimiters>
            <delimiter>@</delimiter>
          </delimiters>
          <useDefaultDelimiters>false</useDefaultDelimiters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    This is the only place a BPMS is named: the application decides which adapter is
    loaded. The workflow module does not know and does not care.
  -->
  <profiles>
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bpms>camunda7</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.camunda.community.vanillabp</groupId>
          <artifactId>camunda7-adapter-quarkus</artifactId>
          <version>${camunda7-adapter.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <bpms>camunda8</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.camunda.community.vanillabp</groupId>
          <artifactId>camunda8-adapter-quarkus</artifactId>
          <version>${camunda8-adapter.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
