<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.module-packaging-springboot</groupId>
    <artifactId>module-packaging</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>application</artifactId>
  <name>The application</name>
  <description>The Spring Boot application collecting both workflow modules and deciding which BPMS is used.</description>

  <!--
    One place naming the version of every workflow module in this runtime. A module release
    is a line changed here, and nothing in the application's code moves with it.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.acme.lending</groupId>
        <artifactId>loan-approval</artifactId>
        <version>1.4.0</version>
      </dependency>
      <dependency>
        <groupId>com.acme.lending</groupId>
        <artifactId>loan-repayment</artifactId>
        <version>2.1.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      The workflow modules this runtime is assembled from. Their versions are pinned below,
      in dependencyManagement, and updating a module is a version bump there and nothing
      else. This is everything the application says about them: no scan, no entity list, no
      property of theirs - each module brings its own wiring.
    -->
    <dependency>
      <groupId>com.acme.lending</groupId>
      <artifactId>loan-approval</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.lending</groupId>
      <artifactId>loan-repayment</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>online-banking</finalName>
    <plugins>
      <!--
        What a deployment sets from outside, here as a system property so a test can read it:
        it wins over the module's own file and over application.yaml. In a container this
        would be the environment variable LOAN_APPROVAL_RATING_PROVIDER.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <spring.profiles.active>${bpms}</spring.profiles.active>
            <loan-approval.rating-provider>from-the-environment</loan-approval.rating-provider>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!--
            The image this runtime ships as, built by 'spring-boot:build-image'. It carries
            the version of the application, not of any module: which module versions went in
            is the POM's business and is visible in the layers.
          -->
          <image>
            <name>online-banking:${project.version}</name>
          </image>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    This is the only place a BPMS is named: the application decides which adapter is
    loaded. The workflow module does not know and does not care.
  -->
  <profiles>
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bpms>camunda7</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.camunda.community.vanillabp</groupId>
          <artifactId>camunda7-adapter-spring-boot</artifactId>
          <version>${camunda7-adapter.version}</version>
        </dependency>
        <!--
          Camunda's Cockpit, Tasklist and Admin at /camunda. Optional in every sense: the
          adapter works without it, and an application which does not want the web
          applications leaves the dependency out.
        -->
        <dependency>
          <groupId>org.camunda.community.vanillabp</groupId>
          <artifactId>camunda7-adapter-spring-boot-webapps</artifactId>
          <version>${camunda7-adapter.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <bpms>camunda8</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.camunda.community.vanillabp</groupId>
          <artifactId>camunda8-adapter-spring-boot</artifactId>
          <version>${camunda8-adapter.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
