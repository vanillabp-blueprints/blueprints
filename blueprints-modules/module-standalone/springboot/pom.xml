<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>io.vanillabp.blueprint.module-standalone-springboot</groupId>
  <artifactId>module-standalone</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>Blueprint: the application is the workflow module</name>
  <description>One Maven module: the application and the workflow module are the same artifact, which is all it takes when there will never be a second use case.</description>

  <properties>
    <!--
      The name of the BPMS profile, set by every BPMS profile below and used twice: the build
      filters it into 'application.yaml' (so the application loads
      'application-<bpms>.yaml'), and the tests get it as a system property. That way the
      profile is named ONCE, on the Maven command line.
    -->
    <bpms>none</bpms>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>21</java.version>
    <!-- All VanillaBP artifacts are version managed by the VanillaBP BOM. -->
    <vanillabp.version>2.0.0-SNAPSHOT</vanillabp.version>
    <!-- BPMS adapters are released independently of the platform, so they carry their own version. -->
    <camunda7-adapter.version>2.0.0-SNAPSHOT</camunda7-adapter.version>
    <camunda8-adapter.version>2.0.0-SNAPSHOT</camunda8-adapter.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-bom</artifactId>
        <version>${vanillabp.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      The VanillaBP APIs the business code uses. It exposes no BPMS API on purpose, and here
      that matters as much as in a project with a workflow module of its own: the code of the
      use case must not know which engine runs it, no matter which artifact it sits in.
    -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-spring-boot-support</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>loan-approval</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
      <!--
        A blueprint must never show a deprecated API - it is copied, and what is copied
        spreads. Making the compiler say so is cheaper than noticing it years later.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:deprecation,removal</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- The BPMS profile of the build, so a test loads the same configuration as the application. -->
            <spring.profiles.active>${bpms}</spring.profiles.active>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- Tests named *IT are integration tests and run in 'verify', not in 'test'. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <spring.profiles.active>${bpms}</spring.profiles.active>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    The BPMS is a Maven profile, never a code change: '-Pcamunda7' (the default) or
    '-Pcamunda8'. Not a single Java file of this blueprint differs between them - only which
    adapter is on the classpath and which directory the BPMN files are read from.
  -->
  <profiles>
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bpms>camunda7</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.camunda.community.vanillabp</groupId>
          <artifactId>camunda7-adapter-spring-boot</artifactId>
          <version>${camunda7-adapter.version}</version>
        </dependency>
        <!--
          Camunda's Cockpit, Tasklist and Admin at /camunda. Optional in every sense: the
          adapter works without it, and an application which does not want the web
          applications leaves the dependency out.
        -->
        <dependency>
          <groupId>org.camunda.community.vanillabp</groupId>
          <artifactId>camunda7-adapter-spring-boot-webapps</artifactId>
          <version>${camunda7-adapter.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <bpms>camunda8</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.camunda.community.vanillabp</groupId>
          <artifactId>camunda8-adapter-spring-boot</artifactId>
          <version>${camunda8-adapter.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
