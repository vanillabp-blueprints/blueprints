<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.module-under-load-springboot</groupId>
    <artifactId>credit-bureau-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>credit-bureau-api-client</artifactId>
  <name>API 'credit bureau': client</name>
  <description>What the application needs from the two OpenAPI files of the credit bureau: the client of the bureau and the interface of the callback.</description>

  <!--
    The generated client and its AutoConfiguration. The REST client classes come from the
    support of the Business Cockpit: 'ClientsConfigurationBase' builds an OpenFeign client out of
    the standard client keys. The Jackson 2 libraries are there only because the generated
    supporting files import them. The JSON bodies are read and written with the Jackson 3 mapper
    of the application.
  -->
  <dependencies>
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>business-cockpit-spring-boot-support</artifactId>
      <version>${businesscockpit.version}</version>
    </dependency>
    <!-- The AutoConfiguration, and the Jackson 3 mapper the client reads and writes JSON with. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
    </dependency>
    <!-- The interface of the callback, which the REST adapter implements. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.openfeign</groupId>
      <artifactId>feign-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Generates what the application needs: the client of '../credit-bureau.yaml', which asks
        for a score, and the interface of '../credit-bureau-callback.yaml', which the REST
        adapter implements to take the answer.
        The settings all generated code shares are in the POM of the blueprint.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>credit-bureau-client</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../credit-bureau.yaml</inputSpec>
              <apiPackage>blueprint.externalsystems.creditbureau.api.client</apiPackage>
              <modelPackage>blueprint.externalsystems.creditbureau.api.client.model</modelPackage>
              <invokerPackage>blueprint.externalsystems.creditbureau.api.client.invoker</invokerPackage>
              <!-- An OpenFeign interface. The AutoConfiguration of this module builds the client. -->
              <generatorName>java</generatorName>
              <library>feign</library>
              <generateSupportingFiles>true</generateSupportingFiles>
              <supportingFilesToGenerate>${openapi-generator.feign-supporting-files}</supportingFilesToGenerate>
              <configOptions>
                <!-- The library 'feign' does not know JSpecify. -->
                <useJspecify>false</useJspecify>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>credit-bureau-callback-server</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../credit-bureau-callback.yaml</inputSpec>
              <apiPackage>blueprint.externalsystems.creditbureau.callback.server</apiPackage>
              <modelPackage>blueprint.externalsystems.creditbureau.callback.server.model</modelPackage>
              <configOptions>
                <!-- Only the interface. A controller implements it. -->
                <interfaceOnly>true</interfaceOnly>
                <skipDefaultInterface>true</skipDefaultInterface>
                <!-- The path of the servers entry goes onto the interface, so two APIs fit into one application. -->
                <requestMappingMode>api_interface</requestMappingMode>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
