<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.module-under-load-quarkus</groupId>
    <artifactId>module-under-load</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>application</artifactId>
  <name>The application</name>
  <description>The Quarkus application pulling in the workflow module and the adapter of the credit bureau, and deciding which BPMS is used. It holds nothing for load testing. The load driver runs in the simulator.</description>

  <dependencies>
    <dependency>
      <groupId>io.vanillabp.blueprint.module-under-load-quarkus</groupId>
      <artifactId>loan-approval</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      The adapter of the module's port 'CreditBureau'. The application chooses it, as it
      chooses the BPMS adapter. It talks to the simulator here and to the real bureau in
      production. Only its address differs.
    -->
    <dependency>
      <groupId>io.vanillabp.blueprint.module-under-load-quarkus</groupId>
      <artifactId>credit-bureau-rest-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      The VanillaBP extension. It belongs into the module which builds the application: it
      wires the business code of every workflow module to the BPMS APIs while the
      application is built.
    -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-quarkus-integration</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <!-- The database is the application's decision, the entity is the module's. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-h2</artifactId>
    </dependency>
    <!-- Configuration in YAML, for application.yaml and for the workflow module's own file. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <!--
      Micrometer with the Prometheus registry, and the meters of the connection pool and of the
      JVM. VanillaBP publishes its meters as soon as Micrometer is there. Quarkus shows all of
      them in the Prometheus format, which is what a monitoring system reads, and what the load
      driver in the simulator reads as well. An application in production has the same.
    -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The client of the load run, generated from its OpenAPI file. LoadRunIT starts a run with it. -->
    <dependency>
      <groupId>io.vanillabp.blueprint.module-under-load-quarkus</groupId>
      <artifactId>load-run-api-client</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!--
      Only for the order of the build: the simulator has to be built before LoadRunIT runs.
      Putting it first in the parent's <modules> is not enough. Maven sorts the modules by
      their dependencies, and a parallel build ('-T') builds modules which do not depend on
      each other at the same time. Only this dependency makes Maven wait for the simulator's
      JAR, and only this dependency brings the simulator into 'mvn -pl application -am'.

      It puts nothing on a classpath: the type 'pom' adds no JAR, and the exclusion keeps the
      simulator's own dependencies away. The test talks to the simulator over HTTP.
    -->
    <dependency>
      <groupId>io.vanillabp.blueprint.module-under-load-quarkus</groupId>
      <artifactId>simulator</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <!--
    The one line of build machinery this blueprint needs: 'application.yaml' names the BPMS
    profile of the build, and only Maven knows it. Filtering is restricted to that file, and
    to the '@...@' delimiters, so nothing else in the resources is touched and Quarkus' own
    '${...}' expressions keep working.
  -->
  <build>
    <resources>
      <resource>
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
        <includes>
          <include>application*.yaml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>application*.yaml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <configuration>
          <delimiters>
            <delimiter>@</delimiter>
          </delimiters>
          <useDefaultDelimiters>false</useDefaultDelimiters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <!--
            'quarkus:dev' starts the application with a JMX port on localhost, the management
            interface every JVM has. An operator connects JConsole there, and the load driver of
            the simulator asks the JVM for a full garbage collection there. It is no part of the
            application: the built application starts without it.
          -->
          <jvmArgs>-Dcom.sun.management.jmxremote.port=9010 -Dcom.sun.management.jmxremote.rmi.port=9010 -Dcom.sun.management.jmxremote.host=localhost -Djava.rmi.server.hostname=localhost -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.ssl=false</jvmArgs>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        The application brings the adapters, so the rule of the parent POM which keeps them
        out of a workflow module is switched off here.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-adapter-in-a-workflow-module</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    This is the only place a BPMS is named: the application decides which adapter is
    loaded. The workflow module does not know and does not care.
  -->
  <profiles>
    <!--
      Starts the simulator before LoadRunIT, on a free port, and tells the test where it is. The
      application runs in the JVM of the test, on a free port of its own and with a JMX port,
      and the simulator is told both. Its log goes to target/simulator.log. The simulator ends
      with the build.

      The simulator gets a run size 'tiny' on its command line. LoadRunIT starts it, and it only
      proves that a run starts and finishes.

      The profile is on unless 'simulator.base-url' is given. A test run from the IDE has no
      profile at all, so LoadRunIT skips there, with a message, when no simulator answers.
    -->
    <profile>
      <id>start-stop-simulator</id>
      <activation>
        <property>
          <name>!simulator.base-url</name>
        </property>
      </activation>
      <properties>
        <!-- '-DskipTests' starts no simulator either. -->
        <skipTests>false</skipTests>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>free-ports</id>
                <goals>
                  <goal>reserve-network-port</goal>
                </goals>
                <phase>initialize</phase>
                <configuration>
                  <portNames>
                    <portName>simulator.port</portName>
                    <portName>application.port</portName>
                    <portName>jmx.port</portName>
                  </portNames>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!--
            The runnable JAR of the simulator, from this build, copied to target/. It is not a
            dependency of the test, because it is a whole application.
          -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>simulator-jar</id>
                <goals>
                  <goal>copy</goal>
                </goals>
                <phase>pre-integration-test</phase>
                <configuration>
                  <skip>${skipTests}</skip>
                  <artifactItems>
                    <artifactItem>
                      <groupId>io.vanillabp.blueprint.module-under-load-quarkus</groupId>
                      <artifactId>simulator</artifactId>
                      <version>${project.version}</version>
                      <classifier>runnable</classifier>
                      <destFileName>simulator.jar</destFileName>
                    </artifactItem>
                  </artifactItems>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!--
            Starts the simulator and goes on at once. The test waits until it answers. Maven
            stops it when the build ends, also when the build fails. Its log goes to a file and
            not to the console, so the build output stays readable.
          -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>start-simulator</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>pre-integration-test</phase>
                <configuration>
                  <skip>${skipTests}</skip>
                  <async>true</async>
                  <asyncDestroyOnShutdown>true</asyncDestroyOnShutdown>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-jar</argument>
                    <argument>${project.build.directory}/simulator.jar</argument>
                    <argument>--server.port=${simulator.port}</argument>
                    <argument>--load-run.application.base-url=http://localhost:${application.port}</argument>
                    <argument>--load-run.application.metrics-url=http://localhost:${application.port}/q/metrics</argument>
                    <argument>--load-run.application.jmx-address=localhost:${jmx.port}</argument>
                    <argument>--load-run.sizes.tiny.stage-length=PT2S</argument>
                    <argument>--load-run.sizes.tiny.steps=1</argument>
                    <argument>--load-run.sizes.tiny.drain-at-most=PT1M</argument>
                    <argument>--logging.file.name=${project.build.directory}/simulator.log</argument>
                    <argument>--logging.threshold.console=OFF</argument>
                    <argument>--spring.main.banner-mode=off</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>${maven-failsafe-plugin.version}</version>
            <configuration>
              <!-- The JMX port of the application under test, where the simulator asks for a full collection. -->
              <argLine>-Dcom.sun.management.jmxremote.port=${jmx.port} -Dcom.sun.management.jmxremote.rmi.port=${jmx.port} -Dcom.sun.management.jmxremote.host=localhost -Djava.rmi.server.hostname=localhost -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.ssl=false</argLine>
              <systemPropertyVariables>
                <simulator.base-url>http://localhost:${simulator.port}</simulator.base-url>
                <simulator.log>${project.build.directory}/simulator.log</simulator.log>
                <application.port>${application.port}</application.port>
                <!-- The build started the simulator, so a test which finds none fails instead of skipping. -->
                <simulator.required>true</simulator.required>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bpms>camunda7</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda7-adapter-quarkus</artifactId>
          <version>${camunda7-adapter.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <bpms>camunda8</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda8-adapter-quarkus</artifactId>
          <version>${camunda8-adapter.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>operaton</id>
      <properties>
        <bpms>operaton</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>operaton-adapter-quarkus</artifactId>
          <version>${operaton-adapter.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>cibseven</id>
      <properties>
        <bpms>cibseven</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>cibseven-adapter-quarkus</artifactId>
          <version>${cibseven-adapter.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
