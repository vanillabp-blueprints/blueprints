<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    The simulator is the only user of this module, and the simulator is a Spring Boot
    application. So this module takes the parent of Spring Boot, like the simulator, and not
    the POM of the blueprint. Maven still builds it with the blueprint, because
    '../pom.xml' names it as a module.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>io.vanillabp.blueprint.module-under-load-quarkus</groupId>
  <artifactId>loan-approval-api-client</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>API 'loan approval': client</name>
  <description>The client of the workflow module's API, generated from loan-approval.yaml. The simulator uses it.</description>

  <properties>
    <java.version>21</java.version>
    <openapi-generator.version>7.27.0</openapi-generator.version>
    <!-- The REST client of this module comes from the support of the Business Cockpit. -->
    <businesscockpit.version>0.9.0-SNAPSHOT</businesscockpit.version>
    <!--
      The support is built on OpenFeign. All OpenFeign libraries have to be of one version, the
      one the support is built with.
    -->
    <feign.version>13.18</feign.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.openfeign</groupId>
        <artifactId>feign-bom</artifactId>
        <version>${feign.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    The generated client and its AutoConfiguration. The REST client classes come from the
    support of the Business Cockpit: 'ClientsConfigurationBase' builds an OpenFeign client out of
    the standard client keys. The Jackson 2 libraries are there only because the generated
    supporting files import them. The JSON bodies are read and written with the Jackson 3 mapper
    of the application.
  -->
  <dependencies>
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>business-cockpit-spring-boot-support</artifactId>
      <version>${businesscockpit.version}</version>
    </dependency>
    <!-- The AutoConfiguration, and the Jackson 3 mapper the client reads and writes JSON with. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.openfeign</groupId>
      <artifactId>feign-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Generates the client of the loan approval from '../loan-approval.yaml'. The customers
        and the clerks of the simulator use it.
        The settings of the generator are written out here, because this module does not
        take the POM of the blueprint as its parent.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <!--
          An OpenFeign interface ('java' generator, library 'feign'). Its models are classes
          with getters. The AutoConfiguration of this module builds the client.
        -->
        <configuration>
          <generateApiTests>false</generateApiTests>
          <generateModelTests>false</generateModelTests>
          <configOptions>
            <useJakartaEe>true</useJakartaEe>
            <useTags>true</useTags>
            <openApiNullable>false</openApiNullable>
            <useBeanValidation>false</useBeanValidation>
            <documentationProvider>none</documentationProvider>
            <annotationLibrary>none</annotationLibrary>
            <hideGenerationTimestamp>true</hideGenerationTimestamp>
          </configOptions>
        </configuration>
        <executions>
          <execution>
            <id>loan-approval-client</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../loan-approval.yaml</inputSpec>
              <apiPackage>blueprint.workflowmodule.loanapproval.api.client</apiPackage>
              <modelPackage>blueprint.workflowmodule.loanapproval.api.client.model</modelPackage>
              <invokerPackage>blueprint.workflowmodule.loanapproval.api.client.invoker</invokerPackage>
              <generatorName>java</generatorName>
              <library>feign</library>
              <generateSupportingFiles>true</generateSupportingFiles>
              <!-- The interface extends a marker interface of the generated 'ApiClient', so these files are generated too. -->
              <supportingFilesToGenerate>ApiClient.java,ApiResponse.java,ApiResponseDecoder.java,EncodingUtils.java,StringUtil.java,RFC3339DateFormat.java,RFC3339JavaTimeModule.java,RFC3339InstantDeserializer.java,HttpBasicAuth.java,HttpBearerAuth.java,ApiKeyAuth.java</supportingFilesToGenerate>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
