<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.cockpit-usertasks-in-the-application-springboot</groupId>
    <artifactId>cockpit-usertasks-in-the-application</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>loan-approval</artifactId>
  <name>Workflow module 'loan-approval'</name>
  <description>The workflow module: BPMN models, the code implementing them and the endpoints of the user task forms, packaged as a JAR.</description>

  <dependencies>
    <!--
      The workflow module knows the VanillaBP APIs, but no BPMS: 'vanillabp-spring-boot-support'
      deliberately does not expose any BPMS API, so the hexagonal architecture cannot be
      broken by accident. The adapter is chosen by the application (see ../application).
    -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-spring-boot-support</artifactId>
    </dependency>
    <!--
      The exceptions about a task id, and the handler which answers them with 404 and 409, are
      the same in every module with forms. So the Business Cockpit ships them, and the module
      takes them from there. Like the line above, this knows no BPMS.
    -->
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>business-cockpit-spring-boot-support</artifactId>
      <version>${businesscockpit.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!--
      The module protects its own endpoints: each user task has an authority, and only a user
      who holds it may read, save or complete that task. How users log in is not the module's
      business. The application decides that, once for all its modules.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      Testing the workflow module means running it: the test sources bring their own tiny
      Spring Boot application (TestApplication), a database and a BPMS adapter. This is the
      normal case - a workflow module is a JAR and cannot be started on its own.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Runs a test method as a user with given authorities, to prove who may call an endpoint. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Rewrites the compiled entities so that the persistence layer can load a single
        attribute only when it is read. The data of a user task is such an attribute (see
        Task#data): a form reads the data of its own task, and nobody else needs it. Without
        this step, JPA loads every attribute with the row, whatever the entity asks for.
      -->
      <plugin>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-maven-plugin</artifactId>
        <version>${hibernate.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>enhance</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bpms>camunda7</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda7-adapter-spring-boot</artifactId>
          <version>${camunda7-adapter.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <bpms>camunda8</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda8-adapter-spring-boot</artifactId>
          <version>${camunda8-adapter.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>operaton</id>
      <properties>
        <bpms>operaton</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>operaton-adapter-spring-boot</artifactId>
          <version>${operaton-adapter.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>cibseven</id>
      <properties>
        <bpms>cibseven</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>cibseven-adapter-spring-boot</artifactId>
          <version>${cibseven-adapter.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
