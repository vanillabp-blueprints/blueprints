  <!--
    The API is a contract between repositories. The frontends of this blueprint read it, and
    they are built with npm, not with this POM. So it gets coordinates which name neither the
    platform nor the part it is built in: React, Angular and Vue all ask for the same artifact.
  -->
  <groupId>io.vanillabp.blueprint</groupId>
  <artifactId>cockpit-user-task-api</artifactId>
  <name>API of the user task forms</name>
  <description>The OpenAPI of the endpoints the user task forms call, packaged as a JAR: openapi/loan-approval.yaml.</description>

  <!--
    No code, only the OpenAPI file in src/main/resources/openapi. A frontend unpacks the JAR
    and generates its client from the file. The workflow module implements the same file.
  -->
</project>
