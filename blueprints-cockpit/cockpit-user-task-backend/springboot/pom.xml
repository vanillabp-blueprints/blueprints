<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>io.vanillabp.blueprint.cockpit-user-task-backend-springboot</groupId>
  <artifactId>cockpit-user-task-backend</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Blueprint: user tasks in the Business Cockpit, backend</name>
  <description>The backend of a workflow module whose user tasks the Business Cockpit shows: the workflow module, with the OpenAPI of its forms.</description>

  <!--
    The backend is one of three repositories. It holds what needs Java and Maven only: the
    workflow module, with the OpenAPI of its forms in src/main/resources/openapi. The frontend
    reads that file and builds the user interface with npm. The application takes the workflow module and the user interface and
    runs them. The README says why the three are apart and in which order they are released.
  -->
  <modules>
    <module>loan-approval</module>
  </modules>

  <properties>
    <!--
      The name of the BPMS profile, set by every BPMS profile of the workflow module. The tests
      get it as a system property, so they load 'application-<bpms>.yaml'. That way the BPMS
      is named ONCE, on the Maven command line.
    -->
    <bpms>none</bpms>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>21</java.version>
    <!-- All VanillaBP artifacts are version managed by the VanillaBP BOM. -->
    <vanillabp.version>2.0.0-SNAPSHOT</vanillabp.version>
    <!-- BPMS adapters are released independently of the platform, so they carry their own version. -->
    <camunda7-adapter.version>2.0.0-SNAPSHOT</camunda7-adapter.version>
    <camunda8-adapter.version>2.0.0-8.10-SNAPSHOT</camunda8-adapter.version>
    <cibseven-adapter.version>2.0.0-2.2-SNAPSHOT</cibseven-adapter.version>
    <operaton-adapter.version>2.0.0-SNAPSHOT</operaton-adapter.version>
    <!--
      The cockpit adapters are released with the Business Cockpit, not with VanillaBP. There
      is one per BPMS. The one for Camunda 8 carries the Camunda 8 line in its version, like
      the BPMS adapter it belongs to.
    -->
    <businesscockpit.version>0.9.0-SNAPSHOT</businesscockpit.version>
    <businesscockpit-camunda8.version>0.9.0-8.10-SNAPSHOT</businesscockpit-camunda8.version>
    <!--
      The release train of Spring Cloud, for the gateway the workflow module can use to forward
      its user interface to an nginx. 2025.1 is built against Spring Boot 4.0, and there is no
      train for 4.1 yet. The Spring Boot parent wins for everything the two have in common.
    -->
    <spring-cloud.version>2025.1.4</spring-cloud.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-bom</artifactId>
        <version>${vanillabp.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!--
        A blueprint must never show a deprecated API - it is copied, and what is copied
        spreads. Making the compiler say so is cheaper than noticing it years later.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!--
            Lombok is an annotation processor found on the classpath. A JDK 23 or newer does not
            run such a processor unless the build says so, and then the getters and the logger it
            writes are simply absent. Saying it here keeps the blueprint building on every JDK
            from 21 upwards.
          -->
          <proc>full</proc>
          <compilerArgs>
            <arg>-Xlint:deprecation,removal</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- The BPMS profile of the build, so a test loads the configuration of that BPMS. -->
            <spring.profiles.active>${bpms}</spring.profiles.active>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- Tests named *IT are integration tests and run in 'verify', not in 'test'. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- The BPMS profile of the build, for the same reason surefire gets it: an
                 integration test has to read 'application-<bpms>.yaml'. -->
            <spring.profiles.active>${bpms}</spring.profiles.active>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        A workflow module never depends on an adapter, neither on a BPMS adapter nor on a
        cockpit adapter. Its tests may use one, so the test scope is allowed. Outside the
        tests, the application brings the adapters. This rule breaks the build if a module
        of this blueprint names an adapter outside the test scope, directly or through
        another dependency.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-adapter-in-a-workflow-module</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>io.vanillabp*:*-adapter-spring-boot*</exclude>
                    <exclude>io.vanillabp*:*-adapter-quarkus*</exclude>
                  </excludes>
                  <includes>
                    <include>io.vanillabp*:*-adapter-spring-boot*:*:*:test</include>
                    <include>io.vanillabp*:*-adapter-quarkus*:*:*:test</include>
                  </includes>
                  <message>A workflow module depends on an adapter only in the test scope. The application brings the adapters.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    The BPMS is a Maven profile, never a code change: '-Pcamunda7' (the default),
    '-Pcamunda8', '-Poperaton' or '-Pcibseven'. The profiles are declared by the workflow
    module, which needs the adapters for its test. This backend has no application module.
    The application which runs the workflow module is a repository of its own.
  -->
</project>
