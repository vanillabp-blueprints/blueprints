<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.vanillabp.blueprint.cockpit-workflow-details-application-quarkus</groupId>
  <artifactId>cockpit-workflow-details-application</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>Blueprint: the page of a case in the Business Cockpit, application</name>
  <description>The application which runs the workflow module and serves its user interface to the Business Cockpit.</description>

  <!--
    The application is the last of three repositories. It takes the workflow module of the
    backend and the JAR of the user interface which the frontend built, and runs both. It has
    no code of its own. The README says why the three are apart and in which order they are
    released.
  -->

  <properties>
    <!--
      The name of the BPMS profile, set by every BPMS profile below. It is used twice: the
      build filters it into 'application.yaml', so the application loads
      'application-<bpms>.yaml', and the tests get it as a system property. That way the BPMS
      is named ONCE, on the Maven command line.
    -->
    <bpms>none</bpms>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <quarkus.version>3.40.1.2</quarkus.version>
    <!--
      Without a parent POM nothing manages the versions of the build plugins, and an
      unversioned plugin is resolved to whatever the local repository last learned about.
      Naming them keeps a build reproducible.
    -->
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <!-- Not part of the Quarkus BOM, so this blueprint says which version it uses. -->
    <assertj.version>3.27.7</assertj.version>
    <!-- All VanillaBP artifacts are version managed by the VanillaBP BOM. -->
    <vanillabp.version>2.0.0-SNAPSHOT</vanillabp.version>
    <!-- BPMS adapters are released independently of the platform, so they carry their own version. -->
    <camunda7-adapter.version>2.0.0-SNAPSHOT</camunda7-adapter.version>
    <camunda8-adapter.version>2.0.0-8.10-SNAPSHOT</camunda8-adapter.version>
    <cibseven-adapter.version>2.0.0-2.2-SNAPSHOT</cibseven-adapter.version>
    <operaton-adapter.version>2.0.0-SNAPSHOT</operaton-adapter.version>
    <!--
      The cockpit adapters are released with the Business Cockpit, not with VanillaBP. There
      is one per BPMS. The one for Camunda 8 carries the Camunda 8 line in its version, like
      the BPMS adapter it belongs to. The BOM of the cockpit is not imported, because it
      imports the BOM of another platform. So the version is named here.
    -->
    <businesscockpit.version>0.9.0-SNAPSHOT</businesscockpit.version>
    <businesscockpit-camunda8.version>0.9.0-8.10-SNAPSHOT</businesscockpit-camunda8.version>
    <!-- Generates the clients of the smoke test from the OpenAPI files of the workflow module. -->
    <openapi-generator.version>7.27.0</openapi-generator.version>
    <!--
      The two parts this application is made of. Each one has a release of its own: first the
      backend, then the frontend, then this application. A bot such as Renovate moves these
      two lines from a snapshot to a release.
    -->
    <cockpit-workflow-details-backend.version>1.0.0-SNAPSHOT</cockpit-workflow-details-backend.version>
    <cockpit-workflow-details-ui.version>1.0.0-SNAPSHOT</cockpit-workflow-details-ui.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-bom</artifactId>
        <version>${vanillabp.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The workflow module, released by the backend. -->
    <dependency>
      <groupId>io.vanillabp.blueprint.cockpit-workflow-details-backend-quarkus</groupId>
      <artifactId>loan-approval</artifactId>
      <version>${cockpit-workflow-details-backend.version}</version>
    </dependency>
    <!--
      The user interface of the workflow module, released by the frontend. The JAR holds no
      class. Its files are below 'META-INF/resources/loan-approval/', and Quarkus serves that
      directory of every JAR at '/'. So the cockpit finds the manifest at
      '/loan-approval/bc-manifest.json'.
    -->
    <dependency>
      <groupId>io.vanillabp.blueprint</groupId>
      <artifactId>cockpit-workflow-details-ui</artifactId>
      <version>${cockpit-workflow-details-ui.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!--
      The VanillaBP extension. It belongs into the module which builds the application: it
      wires the business code of every workflow module to the BPMS APIs while the
      application is built.
    -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-quarkus-integration</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <!-- The database is the application's decision, the entity is the module's. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-h2</artifactId>
    </dependency>
    <!-- Configuration in YAML, for application.yaml and for the workflow module's own file. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The smoke test calls the API of the module through the REST client of Quarkus. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-jackson</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    'application.yaml' names the BPMS profile of the build, and only Maven knows it. Filtering
    is restricted to that file and to the '@...@' delimiters, so nothing else in the resources
    is touched and Quarkus' own '${...}' expressions keep working.
  -->
  <build>
    <resources>
      <resource>
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
        <includes>
          <include>application*.yaml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>application*.yaml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <compilerArgs>
            <!--
              A blueprint must never show a deprecated API - it is copied, and what is
              copied spreads. Making the compiler say so is cheaper than noticing it years
              later.
            -->
            <arg>-Xlint:deprecation,removal</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>${maven-resources-plugin.version}</version>
        <configuration>
          <delimiters>
            <delimiter>@</delimiter>
          </delimiters>
          <useDefaultDelimiters>false</useDefaultDelimiters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <systemPropertyVariables>
            <!-- Quarkus brings its own log manager, and it has to be set before the JVM logs. -->
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <!--
              The BPMS profile of the build. A test runs in the 'test' profile, so the BPMS
              profile is its PARENT: what 'application-<bpms>.yaml' says applies as well.
            -->
            <quarkus.config.profile.parent>${bpms}</quarkus.config.profile.parent>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        The clients of the smoke test, generated from the two OpenAPI files of the workflow
        module: 'loan-requests.yaml' with the start of a loan approval, and 'loan-approval.yaml'
        with the endpoints the user interface calls. The workflow module carries both files in
        its JAR, below 'loan-approval/openapi/', so the generator reads them from there. Each is
        an interface of Jakarta REST which the REST client of Quarkus implements, so the test
        writes no path and no field by hand.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <configuration>
          <generatorName>jaxrs-spec</generatorName>
          <generateSupportingFiles>false</generateSupportingFiles>
          <output>${project.build.directory}/generated-test-sources/openapi</output>
          <addCompileSourceRoot>false</addCompileSourceRoot>
          <addTestCompileSourceRoot>true</addTestCompileSourceRoot>
          <apiPackage>blueprint.application.client</apiPackage>
          <modelPackage>blueprint.application.client.model</modelPackage>
          <configOptions>
            <useJakartaEe>true</useJakartaEe>
            <sourceFolder>src/main/java</sourceFolder>
            <useTags>true</useTags>
            <interfaceOnly>true</interfaceOnly>
            <returnResponse>false</returnResponse>
            <useSwaggerAnnotations>false</useSwaggerAnnotations>
            <useMicroProfileOpenAPIAnnotations>false</useMicroProfileOpenAPIAnnotations>
            <useBeanValidation>false</useBeanValidation>
            <openApiNullable>false</openApiNullable>
            <generatePom>false</generatePom>
            <hideGenerationTimestamp>true</hideGenerationTimestamp>
          </configOptions>
        </configuration>
        <dependencies>
          <!-- Where the generator finds the OpenAPI files. -->
          <dependency>
            <groupId>io.vanillabp.blueprint.cockpit-workflow-details-backend-quarkus</groupId>
            <artifactId>loan-approval</artifactId>
            <version>${cockpit-workflow-details-backend.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>loan-requests-test-client</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <phase>generate-test-sources</phase>
            <configuration>
              <inputSpec>loan-approval/openapi/loan-requests.yaml</inputSpec>
            </configuration>
          </execution>
          <execution>
            <id>user-interface-test-client</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <phase>generate-test-sources</phase>
            <configuration>
              <inputSpec>loan-approval/openapi/loan-approval.yaml</inputSpec>
              <!-- 'case' is a word of Java, and the generator would call the class 'ModelCase'. -->
              <modelNameMappings>Case=Case</modelNameMappings>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        Copies the runnable JARs of the Business Cockpit and of the dev shell simulator to
        target/, where 'docker-compose.yaml' starts them. The cockpit asks the simulator for its
        users. This is not part of the build, because only somebody who wants to see the module
        in a cockpit needs it. Run it by hand:

          mvn dependency:copy@business-cockpit
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${maven-dependency-plugin.version}</version>
        <executions>
          <execution>
            <id>business-cockpit</id>
            <goals>
              <goal>copy</goal>
            </goals>
            <phase>none</phase>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.vanillabp.businesscockpit</groupId>
                  <artifactId>container</artifactId>
                  <version>${businesscockpit.version}</version>
                  <classifier>runnable</classifier>
                  <destFileName>business-cockpit.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>io.vanillabp.businesscockpit</groupId>
                  <artifactId>dev-shell-simulator</artifactId>
                  <version>${businesscockpit.version}</version>
                  <classifier>runnable</classifier>
                  <destFileName>dev-shell-simulator.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    The BPMS is a Maven profile, never a code change: '-Pcamunda7' (the default),
    '-Pcamunda8', '-Poperaton' or '-Pcibseven'. Each profile adds two adapters: the BPMS
    adapter, which runs the workflows, and the cockpit adapter of the same BPMS, which reports
    their cases and user tasks to the cockpit. The workflow module knows neither of them.
  -->
  <profiles>
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bpms>camunda7</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda7-adapter-quarkus</artifactId>
          <version>${camunda7-adapter.version}</version>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-camunda7-adapter-quarkus</artifactId>
          <version>${businesscockpit.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <bpms>camunda8</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda8-adapter-quarkus</artifactId>
          <version>${camunda8-adapter.version}</version>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-camunda8-adapter-quarkus</artifactId>
          <version>${businesscockpit-camunda8.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>operaton</id>
      <properties>
        <bpms>operaton</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>operaton-adapter-quarkus</artifactId>
          <version>${operaton-adapter.version}</version>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-operaton-adapter-quarkus</artifactId>
          <version>${businesscockpit.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>cibseven</id>
      <properties>
        <bpms>cibseven</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>cibseven-adapter-quarkus</artifactId>
          <version>${cibseven-adapter.version}</version>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-cibseven-adapter-quarkus</artifactId>
          <version>${businesscockpit.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
