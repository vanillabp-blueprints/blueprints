<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>io.vanillabp.blueprint.cockpit-user-task-bundle-springboot</groupId>
  <artifactId>loan-approval-bundle</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>Blueprint: user tasks in the Business Cockpit, bundle</name>
  <description>The workflow module and its user interface as one library, for an application which runs several workflow modules.</description>

  <!--
    The bundle takes the place of the application repository. It takes the workflow module of
    the backend and the JAR of the user interface which the frontend built, and publishes them
    as one library. An application which runs several workflow modules then adds one
    dependency per module, and that dependency brings the module and its forms. The bundle has
    no code. The workflow module wires itself with an auto-configuration of its own.
  -->

  <properties>
    <!--
      The name of the BPMS profile, set by every BPMS profile below. The tests get it as a
      system property, so they load 'application-<bpms>.yaml'. That way the BPMS is named ONCE,
      on the Maven command line.
    -->
    <bpms>none</bpms>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>21</java.version>
    <!-- All VanillaBP artifacts are version managed by the VanillaBP BOM. -->
    <vanillabp.version>2.0.0-SNAPSHOT</vanillabp.version>
    <!-- BPMS adapters are released independently of the platform, so they carry their own version. -->
    <camunda7-adapter.version>2.0.0-SNAPSHOT</camunda7-adapter.version>
    <camunda8-adapter.version>2.0.0-8.10-SNAPSHOT</camunda8-adapter.version>
    <cibseven-adapter.version>2.0.0-2.2-SNAPSHOT</cibseven-adapter.version>
    <operaton-adapter.version>2.0.0-SNAPSHOT</operaton-adapter.version>
    <!--
      The cockpit adapters are released with the Business Cockpit, not with VanillaBP. There
      is one per BPMS. The one for Camunda 8 carries the Camunda 8 line in its version, like
      the BPMS adapter it belongs to.
    -->
    <businesscockpit.version>0.9.0-SNAPSHOT</businesscockpit.version>
    <businesscockpit-camunda8.version>0.9.0-8.10-SNAPSHOT</businesscockpit-camunda8.version>
    <!--
      The two parts this bundle is made of. Each one has a release of its own: first the
      backend, then the frontend, then this bundle. A bot such as Renovate moves these two
      lines from a snapshot to a release.
    -->
    <cockpit-user-task-backend.version>1.0.0-SNAPSHOT</cockpit-user-task-backend.version>
    <cockpit-user-task-ui.version>1.0.0-SNAPSHOT</cockpit-user-task-ui.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-bom</artifactId>
        <version>${vanillabp.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The workflow module, released by the backend. -->
    <dependency>
      <groupId>io.vanillabp.blueprint.cockpit-user-task-backend-springboot</groupId>
      <artifactId>loan-approval</artifactId>
      <version>${cockpit-user-task-backend.version}</version>
    </dependency>
    <!--
      The user interface of the workflow module, released by the frontend. Its files are below
      'META-INF/resources/loan-approval/', so the application serves them at '/loan-approval/'.
      The React, the Angular and the Vue frontend publish a JAR under these same coordinates.
      Which one the bundle carries is decided by what the Maven repository holds.
    -->
    <dependency>
      <groupId>io.vanillabp.blueprint</groupId>
      <artifactId>cockpit-user-task-ui</artifactId>
      <version>${cockpit-user-task-ui.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!--
      The test runs the bundle in a small application of its own, the way an application with
      several workflow modules takes it: from a package which does not reach the module.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        A blueprint must never show a deprecated API - it is copied, and what is copied
        spreads. Making the compiler say so is cheaper than noticing it years later.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:deprecation,removal</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- The BPMS profile of the build, so a test loads the configuration of that BPMS. -->
            <spring.profiles.active>${bpms}</spring.profiles.active>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!--
        A workflow module never depends on an adapter, neither on a BPMS adapter nor on a
        cockpit adapter, and neither does the bundle of one. Its tests may use one, so the
        test scope is allowed. Outside the tests, the application brings the adapters. This
        rule breaks the build if the bundle names an adapter outside the test scope, directly
        or through another dependency.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-adapter-in-a-workflow-module</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>io.vanillabp*:*-adapter-spring-boot*</exclude>
                    <exclude>io.vanillabp*:*-adapter-quarkus*</exclude>
                  </excludes>
                  <includes>
                    <include>io.vanillabp*:*-adapter-spring-boot*:*:*:test</include>
                    <include>io.vanillabp*:*-adapter-quarkus*:*:*:test</include>
                  </includes>
                  <message>A workflow module depends on an adapter only in the test scope. The application brings the adapters.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    The BPMS is a Maven profile, never a code change: '-Pcamunda7' (the default),
    '-Pcamunda8', '-Poperaton' or '-Pcibseven'. The bundle carries no adapter. The application
    which takes it chooses the BPMS adapter and the cockpit adapter of the same BPMS, once for
    all its workflow modules. So each profile adds both adapters to the test only.
  -->
  <profiles>
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bpms>camunda7</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda7-adapter-spring-boot</artifactId>
          <version>${camunda7-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-camunda7-adapter-spring-boot</artifactId>
          <version>${businesscockpit.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <bpms>camunda8</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda8-adapter-spring-boot</artifactId>
          <version>${camunda8-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-camunda8-adapter-spring-boot</artifactId>
          <version>${businesscockpit-camunda8.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>operaton</id>
      <properties>
        <bpms>operaton</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>operaton-adapter-spring-boot</artifactId>
          <version>${operaton-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-operaton-adapter-spring-boot</artifactId>
          <version>${businesscockpit.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>cibseven</id>
      <properties>
        <bpms>cibseven</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>cibseven-adapter-spring-boot</artifactId>
          <version>${cibseven-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-cibseven-adapter-spring-boot</artifactId>
          <version>${businesscockpit.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
