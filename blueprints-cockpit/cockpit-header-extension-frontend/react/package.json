{
  "name": "cockpit-header-extension-frontend-react",
  "private": true,
  "version": "1.0.0-SNAPSHOT",
  "description": "The button \"Request a loan\" in the header of a VanillaBP Business Cockpit and the start form it opens, for the workflow module loan-approval, written in React. Builds the UI jar and an nginx image.",
  "license": "Apache-2.0",
  "author": "Phactum Softwareentwicklung GmbH (https://www.phactum.at/)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "workflowModuleId": "loan-approval",
    "uiJar": "io.vanillabp.blueprint:cockpit-header-extension-ui",
    "openapi": "backend/loan-approval/src/main/resources/openapi/loan-approval.yaml",
    "openapiInMonorepo": "../../cockpit-header-extension-backend/springboot/loan-approval/src/main/resources/openapi/loan-approval.yaml",
    "image": "vanillabp-blueprints/cockpit-header-extension-ui"
  },
  "scripts": {
    "fetch:openapi": "node scripts/fetch-openapi.mjs",
    "generate:client": "openapi-typescript build/openapi/loan-approval.yaml --output src/generated/loan-approval.ts",
    "typecheck": "tsc --noEmit",
    "build:micro-frontends": "node scripts/build-micro-frontends.mjs",
    "check:entries": "bc-check-entries dist/micro-frontends/bc-manifest.json --metafile build/meta.json --data-entry Header",
    "build:jar": "node scripts/build-ui-jar.mjs",
    "build:image": "node scripts/build-image.mjs",
    "build": "npm run fetch:openapi && npm run generate:client && npm run typecheck && npm run build:micro-frontends && npm run check:entries && npm run build:jar && node scripts/build-image.mjs --skip-without-docker",
    "test": "node --test --test-concurrency=1 \"test/browser/**/*.test.js\"",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanillabp/bc-module-host": "0.1.0-snapshot.2",
    "@vanillabp/bc-module-kit": "0.1.0-snapshot.2",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "openapi-typescript": "7.13.0",
    "playwright": "1.65.0",
    "typescript": "5.9.3"
  }
}
