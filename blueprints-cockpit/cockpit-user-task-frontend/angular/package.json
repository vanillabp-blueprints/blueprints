{
  "name": "cockpit-user-task-frontend-angular",
  "private": true,
  "version": "1.0.0-SNAPSHOT",
  "description": "The micro-frontends of the workflow module loan-approval for a VanillaBP Business Cockpit, written in Angular. Builds the UI jar and an nginx image.",
  "license": "Apache-2.0",
  "author": "Phactum Softwareentwicklung GmbH (https://www.phactum.at/)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "workflowModuleId": "loan-approval",
    "uiJar": "io.vanillabp.blueprint:cockpit-user-task-ui",
    "openapi": "backend/loan-approval/src/main/resources/openapi/loan-approval.yaml",
    "openapiInMonorepo": "../../cockpit-user-task-backend/springboot/loan-approval/src/main/resources/openapi/loan-approval.yaml",
    "image": "vanillabp-blueprints/cockpit-user-task-ui"
  },
  "scripts": {
    "fetch:openapi": "node scripts/fetch-openapi.mjs",
    "generate:client": "openapi-typescript build/openapi/loan-approval.yaml --output src/generated/loan-approval.ts",
    "compile": "ngc -p tsconfig.json",
    "build:micro-frontends": "node scripts/build-micro-frontends.mjs",
    "check:entries": "bc-check-entries dist/micro-frontends/bc-manifest.json --metafile build/meta.json",
    "build:jar": "node scripts/build-ui-jar.mjs",
    "build:image": "node scripts/build-image.mjs",
    "build": "npm run fetch:openapi && npm run generate:client && npm run compile && npm run build:micro-frontends && npm run check:entries && npm run build:jar && node scripts/build-image.mjs --skip-without-docker",
    "test": "node --test --test-concurrency=1 \"test/browser/**/*.test.js\"",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "openapi-fetch": "0.17.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/compiler": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@babel/core": "8.1.0",
    "@vanillabp/bc-module-host": "0.1.0-snapshot.2",
    "@vanillabp/bc-module-kit": "0.1.0-snapshot.2",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "openapi-typescript": "7.13.0",
    "playwright": "1.65.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
