{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "loan-approval": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/entries.ts",
            "tsConfig": "tsconfig.json",
            "index": false,
            "polyfills": [],
            "outputPath": {
              "base": "dist/micro-frontends",
              "browser": ""
            },
            "outputHashing": "all",
            "namedChunks": true,
            "statsJson": true
          }
        }
      }
    }
  }
}
