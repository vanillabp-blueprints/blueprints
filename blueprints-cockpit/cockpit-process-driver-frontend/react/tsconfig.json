{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@loan-approval": ["./src/loan-approval.ts"],
      "@shared": ["./src/shared/index.ts"],
      "@gui-client": ["./src/shared/api.ts"],
      "@process-driver-client": ["./src/shared/process-driver-api.ts"],
      "@generated": ["./src/generated/loan-approval/index.ts"],
      "@generated-process-driver": ["./src/generated/process-driver/index.ts"]
    }
  },
  "include": ["src", "dev-shell/src"]
}
