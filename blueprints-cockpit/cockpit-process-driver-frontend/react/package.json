{
  "name": "cockpit-process-driver-frontend-react",
  "private": true,
  "version": "1.0.0-SNAPSHOT",
  "description": "The forms of the user tasks of the workflow module loan-approval for a VanillaBP Business Cockpit, written in React, and a dev shell whose page \"Process driver\" brings a new case to a chosen state. Builds the UI jar and an nginx image.",
  "license": "Apache-2.0",
  "author": "Phactum Softwareentwicklung GmbH (https://www.phactum.at/)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "workflowModuleId": "loan-approval",
    "uiJar": "io.vanillabp.blueprint:cockpit-process-driver-ui",
    "openapi": {
      "loan-approval": "backend/loan-approval/workflow-module/src/main/resources/loan-approval/openapi/loan-approval.yaml",
      "process-driver": "backend/loan-approval/test-driver/src/main/resources/loan-approval/openapi/process-driver.yaml"
    },
    "openapiInMonorepo": {
      "loan-approval": "../../../blueprints-modules/module-process-driver/springboot/loan-approval/workflow-module/src/main/resources/loan-approval/openapi/loan-approval.yaml",
      "process-driver": "../../../blueprints-modules/module-process-driver/springboot/loan-approval/test-driver/src/main/resources/loan-approval/openapi/process-driver.yaml"
    },
    "image": "vanillabp-blueprints/cockpit-process-driver-ui"
  },
  "scripts": {
    "fetch:openapi": "node scripts/fetch-openapi.mjs",
    "generate:client": "openapi-ts",
    "check:imports": "node scripts/check-imports.mjs",
    "typecheck": "tsc --noEmit",
    "build:micro-frontends": "node scripts/build-micro-frontends.mjs",
    "check:entries": "bc-check-entries dist/micro-frontends/bc-manifest.json --metafile build/meta.json",
    "build:dev-shell": "node scripts/build-dev-shell.mjs",
    "build:jar": "node scripts/build-ui-jar.mjs",
    "build:image": "node scripts/build-image.mjs",
    "build": "npm run check:imports && npm run fetch:openapi && npm run generate:client && npm run typecheck && npm run build:micro-frontends && npm run check:entries && npm run build:dev-shell && npm run build:jar && node scripts/build-image.mjs --skip-without-docker",
    "test": "node --test --test-concurrency=1 \"test/browser/**/*.test.js\"",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanillabp/bc-module-host": "0.1.0-snapshot.2",
    "@vanillabp/bc-module-kit": "0.1.0-snapshot.2",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "playwright": "1.65.1",
    "typescript": "5.9.3"
  }
}
