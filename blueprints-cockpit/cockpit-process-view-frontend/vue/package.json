{
  "name": "cockpit-process-view-frontend-vue",
  "private": true,
  "version": "1.0.0-SNAPSHOT",
  "description": "The process of a case on the case page of the workflow module loan-approval for a VanillaBP Business Cockpit, drawn with bpmn-js, written in Vue. Builds the UI jar and an nginx image.",
  "license": "Apache-2.0",
  "author": "Phactum Softwareentwicklung GmbH (https://www.phactum.at/)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "workflowModuleId": "loan-approval",
    "uiJar": "io.vanillabp.blueprint:cockpit-process-view-ui",
    "openapi": "backend/loan-approval/src/main/resources/loan-approval/openapi/loan-approval.yaml",
    "openapiInMonorepo": "../../../blueprints-bpmn/bpmn-history-and-diagram/springboot/loan-approval/src/main/resources/loan-approval/openapi/loan-approval.yaml",
    "image": "vanillabp-blueprints/cockpit-process-view-ui"
  },
  "scripts": {
    "fetch:openapi": "node scripts/fetch-openapi.mjs",
    "generate:client": "openapi-ts",
    "check:imports": "node scripts/check-imports.mjs",
    "write:bc-build": "node scripts/write-bc-build.mjs",
    "typecheck": "vue-tsc --noEmit",
    "build:micro-frontends": "node scripts/build-micro-frontends.mjs",
    "check:entries": "bc-check-entries dist/micro-frontends/bc-manifest.json --metafile build/meta.json",
    "build:jar": "node scripts/build-ui-jar.mjs",
    "build:image": "node scripts/build-image.mjs",
    "build": "npm run check:imports && npm run fetch:openapi && npm run generate:client && npm run write:bc-build && npm run typecheck && npm run build:micro-frontends && npm run check:entries && npm run build:jar && node scripts/build-image.mjs --skip-without-docker",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "bpmn-js": "18.31.1",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@vanillabp/bc-module-host": "0.1.0-snapshot.6",
    "@vanillabp/bc-module-kit": "0.1.0-snapshot.5",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.14"
  }
}
