<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.blueprint.cockpit-workflow-details-backend-quarkus</groupId>
    <artifactId>cockpit-workflow-details-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>loan-approval</artifactId>
  <name>Workflow module 'loan-approval'</name>
  <description>The workflow module: BPMN models, the code implementing them, the endpoints of the case page and what the Business Cockpit needs to show the cases, packaged as a JAR.</description>

  <properties>
    <!--
      The stand-in for the Business Cockpit which the integration test reports to. It is the
      dev shell simulator of the cockpit: a small application of its own which takes the
      reports a workflow module sends and serves them back. The test starts its runnable JAR.
    -->
    <dev-shell-simulator.version>0.9.0-SNAPSHOT</dev-shell-simulator.version>
  </properties>

  <dependencies>
    <!--
      The workflow module knows the VanillaBP APIs, but no BPMS: 'vanillabp-quarkus-support'
      deliberately does not expose any BPMS API, so the hexagonal architecture cannot be
      broken by accident. The adapter is chosen by the application.
    -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-quarkus-support</artifactId>
    </dependency>
    <!--
      The same for the Business Cockpit: its annotations and types, such as
      @WorkflowDetailsProvider, and classes a workflow module of the cockpit may share, such as
      the details of the user who is logged in. Like the line above, this knows no BPMS. The
      cockpit adapter of the BPMS is chosen by the application, next to the BPMS adapter.
    -->
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>business-cockpit-quarkus-support</artifactId>
      <version>${businesscockpit.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm-panache</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      Testing the workflow module means running it: the test sources add a database, a BPMS
      adapter and a cockpit adapter, and Quarkus boots the module out of this Maven module.
      This is the normal case - a workflow module is a JAR and is not deployed on its own.
    -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-quarkus-integration</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The module has two APIs, each written as an OpenAPI file. This plugin generates a Java
        interface from each, with the paths, the parameters and the answers, and the classes of
        the answers.
        'src/main/resources/openapi/loan-approval.yaml' holds the endpoints the case page calls.
        The frontend generates its client from the same file. 'CasePageController' implements
        the interface 'CasesApi'.
        'src/main/resources/openapi/loan-requests.yaml' holds the GET endpoints a person uses to
        start a loan approval and look at it. 'ApiController' implements 'LoanRequestsApi'.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <!-- The settings every API of this module shares. -->
        <configuration>
          <!-- Jakarta REST, which Quarkus REST implements. -->
          <generatorName>jaxrs-spec</generatorName>
          <generateSupportingFiles>false</generateSupportingFiles>
          <configOptions>
            <useJakartaEe>true</useJakartaEe>
            <!-- Where the build looks for sources. The default of this generator is a folder it does not. -->
            <sourceFolder>src/main/java</sourceFolder>
            <!-- One interface per tag, named after it. -->
            <useTags>true</useTags>
            <!-- Only the interface. The resource class implements it. -->
            <interfaceOnly>true</interfaceOnly>
            <!-- A method returns the answer itself. Quarkus turns it into the response. -->
            <returnResponse>false</returnResponse>
            <!-- No library beyond Jakarta REST and Jackson: no Swagger annotations, no bean validation. -->
            <useSwaggerAnnotations>false</useSwaggerAnnotations>
            <useMicroProfileOpenAPIAnnotations>false</useMicroProfileOpenAPIAnnotations>
            <useBeanValidation>false</useBeanValidation>
            <openApiNullable>false</openApiNullable>
            <generatePom>false</generatePom>
            <hideGenerationTimestamp>true</hideGenerationTimestamp>
          </configOptions>
        </configuration>
        <executions>
          <execution>
            <id>case-page-api</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/loan-approval.yaml</inputSpec>
              <apiPackage>blueprint.workflowmodule.loanapproval.api</apiPackage>
              <modelPackage>blueprint.workflowmodule.loanapproval.api.model</modelPackage>
              <!-- 'case' is a word of Java, and the generator would call the class 'ModelCase'. -->
              <modelNameMappings>Case=Case</modelNameMappings>
            </configuration>
          </execution>
          <execution>
            <id>loan-requests-api</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/loan-requests.yaml</inputSpec>
              <apiPackage>blueprint.workflowmodule.loanapproval.api</apiPackage>
              <modelPackage>blueprint.workflowmodule.loanapproval.api.model</modelPackage>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        A workflow module is a Maven module of its own, so the application's build does not
        see its classes. The index is what makes them visible: without it, the
        '@WorkflowService' class of this module is never found.
      -->
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <version>${jandex-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>make-index</id>
            <goals>
              <goal>jandex</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        Copies the runnable JAR of the dev shell simulator to target/, where the integration
        test starts it. It is not a dependency, because it is a whole application and none of
        its classes belong on the classpath of the test.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${maven-dependency-plugin.version}</version>
        <executions>
          <execution>
            <id>dev-shell-simulator</id>
            <goals>
              <goal>copy</goal>
            </goals>
            <phase>pre-integration-test</phase>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.vanillabp.businesscockpit</groupId>
                  <artifactId>dev-shell-simulator</artifactId>
                  <version>${dev-shell-simulator.version}</version>
                  <classifier>runnable</classifier>
                  <destFileName>dev-shell-simulator.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- Where the test finds the simulator, and where it writes the simulator's log. -->
            <dev-shell-simulator.jar>${project.build.directory}/dev-shell-simulator.jar</dev-shell-simulator.jar>
            <dev-shell-simulator.log>${project.build.directory}/dev-shell-simulator.log</dev-shell-simulator.log>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    One profile per BPMS. Each adds two adapters to the test: the BPMS adapter, which runs the
    workflows, and the cockpit adapter of the same BPMS, which reports their user tasks to the
    cockpit. The application which runs this workflow module declares the same two.
  -->
  <profiles>
    <profile>
      <id>camunda7</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bpms>camunda7</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda7-adapter-quarkus</artifactId>
          <version>${camunda7-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-camunda7-adapter-quarkus</artifactId>
          <version>${businesscockpit.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>camunda8</id>
      <properties>
        <bpms>camunda8</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>camunda8-adapter-quarkus</artifactId>
          <version>${camunda8-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-camunda8-adapter-quarkus</artifactId>
          <version>${businesscockpit-camunda8.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>operaton</id>
      <properties>
        <bpms>operaton</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>operaton-adapter-quarkus</artifactId>
          <version>${operaton-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-operaton-adapter-quarkus</artifactId>
          <version>${businesscockpit.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>cibseven</id>
      <properties>
        <bpms>cibseven</bpms>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.vanillabp</groupId>
          <artifactId>cibseven-adapter-quarkus</artifactId>
          <version>${cibseven-adapter.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.vanillabp.businesscockpit</groupId>
          <artifactId>businesscockpit-cibseven-adapter-quarkus</artifactId>
          <version>${businesscockpit.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
